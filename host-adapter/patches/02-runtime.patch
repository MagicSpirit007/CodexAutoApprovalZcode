+import { existsSync } from "node:fs";
+import { createHash, randomUUID } from "node:crypto";
+import { reviewModelSelectionSchema, type ApprovalBridgeFactory, type ModelSelection } from "@zcode/contracts";
+import { loadFileConfig } from "../config/index.js";
+import { createNodeApprovalBridgeWithActivity } from "./approval-bridge.js";
+
+/** Read the same native config parser used by plugin enable/disable commands. */
+export function createConfiguredNodeApprovalBridge(configPaths: string[], native?: {
+  configurationVersion(): number;
+  validateSelection(selection: ModelSelection): { ok: true } | { ok: false; code: string; message?: string };
+}): ApprovalBridgeFactory {
+  let previousFingerprint = "", revision = randomUUID();
+  const factory = createNodeApprovalBridgeWithActivity(plugin => {
+    if (!plugin) return true;
+    if (!existsSync(plugin.rootPath)) return false;
+    let enabled = true;
+    let pluginEnabled = true;
+    // 配置按 user → project 顺序合并；任一 false 都否决会错误阻断菜单写入的 workspace true。
+    for (const file of configPaths) {
+      if (!existsSync(file)) continue;
+      const loaded = loadFileConfig(file);
+      // 选择配置损坏应由 snapshot 返回具体技术失败，不能被误当成用户停用。
+      enabled = loaded.config.plugins?.enabled ?? enabled;
+      pluginEnabled = loaded.config.plugins?.enabledPlugins?.[plugin.id] ?? pluginEnabled;
+    }
+    return enabled && pluginEnabled;
+  });
+  return owner => factory({
+    ...owner,
+    snapshot(plugin) {
+      const snapshot = owner.snapshot(plugin) as Record<string, unknown>;
+      let option: unknown;
+      const configurations = configPaths.map(file => {
+        if (!existsSync(file)) return undefined;
+        const loaded = loadFileConfig(file);
+        if (loaded.diagnostics.some(item => item.severity === "error")) {
+          throw Object.assign(new Error("Automatic review configuration is invalid"), { code: "review_configuration_invalid" });
+        }
+        const options = loaded.config.plugins?.options;
+        const id = plugin?.id;
+        const configured = id ? options?.[id]?.reviewModel : undefined;
+        if (configured !== undefined) option = configured;
+        return loaded.config;
+      });
+      const selection = reviewModelSelectionSchema.safeParse(option ?? { mode: "inherit" });
+      if (!selection.success) throw Object.assign(new Error("Automatic review model configuration is invalid"), { code: "review_configuration_invalid" });
+      const actualReviewSelection = selection.data.mode === "inherit" ? snapshot.modelSnapshot as ModelSelection : {
+        providerId: selection.data.providerId, modelId: selection.data.modelId, ...("options" in selection.data ? { options: selection.data.options } : {}),
+      };
+      const validation = native?.validateSelection(actualReviewSelection);
+      if (validation && !validation.ok) throw Object.assign(new Error(validation.message ?? "Configured review model is unavailable or incompatible"), { code: `review_${validation.code.replaceAll("-", "_")}` });
+      // 配置摘要仅在宿主持有；对插件暴露随机版本，不能用凭据摘要作为可关联的标识。
+      const fingerprint = createHash("sha256").update(JSON.stringify({ configurations, native: native?.configurationVersion() })).digest("hex");
+      if (fingerprint !== previousFingerprint) { previousFingerprint = fingerprint; revision = randomUUID(); }
+      return { ...snapshot, actualReviewSelection, reviewConfigurationVersion: revision };
+    },
+  });
+}
diff --git a/apps/zcode-cli/packages/adapters/src/exec/approval-review-failure.ts b/apps/zcode-cli/packages/adapters/src/exec/approval-review-failure.ts
