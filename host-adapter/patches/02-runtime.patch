@@ -0,0 +1,30 @@
+import { approvalReviewFailure, type ApprovalReviewFailure } from "@zcode/contracts";
+import { AiSdkModelAdapterError } from "../model/errors.js";
+import { classifyModelFailure, inspectProviderFailure } from "../model/failure-classifier.js";
+import { getResponseHeaders } from "../model/failure-inspection.js";
+
+const EXPLICIT_PROVIDER_BLOCK = /^request has been blocked due to unusual activity\.?$/i;
+
+/** Existing host boundary owns the only provider-to-review error conversion. */
+export function normalizeApprovalReviewFailure(error: unknown): ApprovalReviewFailure {
+  const value = error as Error & Partial<ApprovalReviewFailure> & { providerCode?: string | number; providerRequestId?: string; statusCode?: number; responseStatus?: number };
+  const classified = classifyModelFailure(error);
+  const details = inspectProviderFailure(error);
+  const headers = getResponseHeaders(error);
+  // 原生 adapter 将诊断保存在 context；只取已知字段，不能展开私有请求或响应。
+  const context = error instanceof AiSdkModelAdapterError ? error.context : undefined;
+  const httpStatus = classified.statusCode ?? value?.httpStatus ?? value?.responseStatus ?? value?.statusCode ?? context?.statusCode;
+  const providerEvidence = error instanceof AiSdkModelAdapterError || details.providerErrorCode !== undefined || classified.statusCode !== undefined;
+  // 405 本身并不代表风控；只认供应商明确返回的拦截说明，不伪装主会话或追加重试。
+  const blocked = providerEvidence && typeof value?.message === "string" && EXPLICIT_PROVIDER_BLOCK.test(value.message.trim());
+  return approvalReviewFailure({
+    code: blocked ? "provider_request_blocked" : value?.code,
+    name: blocked ? undefined : value?.name,
+    message: value?.message,
+    businessCode: details.providerErrorCode ?? value?.businessCode ?? value?.providerCode ?? context?.providerErrorCode,
+    httpStatus,
+    requestId: details.providerRequestId ?? headers?.["x-request-id"] ?? headers?.["request-id"] ?? value?.requestId ?? value?.providerRequestId ?? context?.requestId,
+    retryAfterMs: classified.retryAfterMs ?? value?.retryAfterMs ?? context?.retryAfterMs,
+    retryable: blocked ? false : value?.retryable ?? (typeof context?.retryable === "boolean" ? context.retryable : classified.retryable),
+  });
+}
diff --git a/apps/zcode-cli/packages/adapters/src/model/approval-responses-options.ts b/apps/zcode-cli/packages/adapters/src/model/approval-responses-options.ts
