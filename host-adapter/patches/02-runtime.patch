@@ -0,0 +1,15 @@
+import { createConfig, resolvePath } from "@zcode/adapters/config";
+import { getCliStorageRoot, getPluginStorageRoot } from "../app/paths.js";
+import type { ZCodeProtocolAgentServerContext } from "./server-types.js";
+import { assertPluginStorageCompatible } from "./update-install-compatibility.js";
+
+/** 原生配置解析权在 CLI；默认、工作区覆盖和自定义 storage.dir 都必须核验。 */
+export function assertUpdatePluginCompatibility(context: ZCodeProtocolAgentServerContext, supported: readonly string[]): void {
+  const directories = new Set<string | undefined>([undefined, context.deps.cwd,
+    ...[...context.sessions.values()].map(record => record.workspace.workspacePath)]);
+  const roots = [...directories].map(workingDirectory => {
+    const config = createConfig({ env: context.deps.env, ...(workingDirectory ? { workingDirectory } : {}) });
+    return getPluginStorageRoot(getCliStorageRoot(resolvePath(config.config.storage.dir)));
+  });
+  assertPluginStorageCompatible(roots, supported);
+}
