@@ -0,0 +1,36 @@
+import { UpdateInstallLease } from "@zcode/shared";
+import type { IChannelServer } from "@zcode/rpc";
+
+export const hostUpdateInstallLease = new UpdateInstallLease();
+
+export async function runAdmittedHostWork<T>(work: () => Promise<T>): Promise<T> {
+  const release = hostUpdateInstallLease.enter();
+  try {
+    return await work();
+  } finally {
+    release();
+  }
+}
+
+export function guardUpdateInstallAdmission(
+  server: IChannelServer,
+): IChannelServer & { ready(): void } {
+  return {
+    registerChannel(name, channel) {
+      server.registerChannel(name, {
+        async call(context, command, arg, cancellationToken) {
+          if (command === "prepareUpdateInstallation" || command === "releaseUpdateInstallation")
+            throw new Error("Update lifecycle is owned by Desktop Main");
+          const release = hostUpdateInstallLease.enter();
+          try {
+            return await channel.call(context, command, arg, cancellationToken);
+          } finally {
+            release();
+          }
+        },
+        listen: (context, event, arg) => channel.listen(context, event, arg),
+      });
+    },
+    ready: () => server.ready?.(),
+  };
+}
