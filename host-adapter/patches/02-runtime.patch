@@ -0,0 +1,26 @@
+import type { ModelSelection } from "@zcode/provider";
+import type { ProviderRegistryModelSource } from "./provider-registry-model-runtime.js";
+
+/** Native resolver diagnostics are inspected in the host; config/keys never enter bridge errors. */
+export function validateApprovalReviewSelection(registry: ProviderRegistryModelSource, selection: ModelSelection):
+  { ok: true } | { ok: false; code: string; message: string } {
+  const result = registry.validateSelection(selection);
+  if (result.ok) {
+    return registry.getModel(selection.providerId, selection.modelId)?.config.properties.supportsToolCall
+      ? { ok: true } : { ok: false, code: "model_incompatible", message: "Configured review model does not support read-only tool investigation" };
+  }
+  if (result.code === "provider-not-found") {
+    const candidate = registry.getSnapshot?.()?.resolution.resolvedProviders.find(provider => provider.providerId === selection.providerId);
+    if (candidate?.providerIssues.some(issue => issue.path.slice(-2).join(".") === "access.apiKey")) {
+      return { ok: false, code: "credentials_missing", message: "Configured review provider is missing its native API key" };
+    }
+    if (candidate) return { ok: false, code: "provider_incompatible", message: "Configured review provider is disabled or its native configuration is incomplete" };
+    return { ok: false, code: "provider_not_found", message: "Configured review provider was deleted or is unavailable" };
+  }
+  const messages = {
+    "model-not-found": "Configured review model was deleted, disabled or has incomplete native configuration",
+    "reasoning-level-missing": "Configured review model requires a reasoning level",
+    "reasoning-level-not-supported": "Configured review reasoning level is not supported by this model",
+  };
+  return { ok: false, code: result.code.replaceAll("-", "_"), message: messages[result.code] };
+}
diff --git a/apps/zcode-cli/packages/bootstrap/src/plugins/review-model-options.ts b/apps/zcode-cli/packages/bootstrap/src/plugins/review-model-options.ts
