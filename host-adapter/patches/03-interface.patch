+      {failure.httpStatus !== undefined || failure.requestId ? (
+        <p className="text-ui-caption leading-5 text-foreground-subtle break-all">
+          {failure.httpStatus !== undefined ? intl.formatMessage({ id: "chat.permission.autoReviewHttpStatus" }, { status: failure.httpStatus }) : null}
+          {failure.httpStatus !== undefined && failure.requestId ? " · " : null}
+          {failure.requestId ? intl.formatMessage({ id: "chat.permission.autoReviewRequestId" }, { requestId: failure.requestId }) : null}
+        </p>
+      ) : null}
+    </div>
+  );
+}
diff --git a/packages/ui/src/hooks/useCodexAutoApprovalMode.ts b/packages/ui/src/hooks/useCodexAutoApprovalMode.ts
new file mode 100755
index 0000000..48ab636
--- /dev/null
+++ b/packages/ui/src/hooks/useCodexAutoApprovalMode.ts
@@ -0,0 +1,107 @@
+import { useCallback, useEffect, useRef } from "react";
+import { isRemoteWorkspaceIdentity } from "@zcode/shared";
+import { usePlatform } from "@/hooks/usePlatform.js";
+import { useBaseWorkspaceServices } from "@/hooks/useWorkspaceServices.js";
+import { usePluginManagementStore } from "@/store/pluginManagementStore.js";
+import { useZCodeSessionStore } from "@/store/zcodeSessionStore.js";
+import { getVisibleTaskMetas, getWorkspaceState } from "@/store/zcodeSessionStoreSelectors.js";
+
+export const CODEX_AUTO_APPROVAL_MODE = "codex-auto-approval";
+const PLUGIN_ID = "codex-auto-approval@codex-auto-review-local";
+const RUNNING_STATUSES = new Set(["creating", "restoring", "streaming"]);
+
+export function useCodexAutoApprovalMode(params: {
+  workspacePath: string;
+  workspaceIdentity?: string;
+  remoteSessionId?: string;
+  currentSessionBusy?: boolean;
+  sessionId: string | null;
+  mode: string;
+  disabled: boolean;
+  onSwitchMode: (mode: string) => void;
+}) {
+  const platform = usePlatform();
+  const service = useBaseWorkspaceServices().pluginManagementService;
+  const identity = params.workspaceIdentity?.trim() || null;
+  const supported = Boolean(
+    params.workspacePath &&
+    service &&
+    typeof platform.executeDesktopCommand === "function" &&
+    /Windows/i.test(navigator.userAgent) &&
+    !params.remoteSessionId &&
+    !(identity && isRemoteWorkspaceIdentity(identity)),
+  );
+  const state = usePluginManagementStore();
+  const sameContext =
+    state.workspacePath === params.workspacePath &&
+    state.workspaceIdentity === identity &&
+    state.configScope === null;
+  const plugin = sameContext ? state.plugins.find((item) => item.id === PLUGIN_ID) : undefined;
+  const enableRequiresNewSession = Boolean(params.sessionId && !plugin?.enabled);
+  const workspaceBusy = useZCodeSessionStore((sessions) => {
+    const workspace = getWorkspaceState(sessions, params.workspacePath, identity ?? undefined);
+    return (
+      Object.values(workspace.taskRuntimeByTaskId ?? {}).some(
+        (runtime) => RUNNING_STATUSES.has(runtime.status) || Boolean(runtime.activeInputId?.trim()),
+      ) || getVisibleTaskMetas(workspace).some((task) => task.status === "running")
+    );
+  });
+  const blocked =
+    params.disabled ||
+    Boolean(params.currentSessionBusy) ||
+    workspaceBusy ||
+    Boolean(state.togglingPluginId || state.operationId) ||
+    (supported && (!sameContext || state.loading));
+  const activeContext = useRef("");
+  activeContext.current = `${params.workspacePath}\0${identity ?? ""}`;
+  const initializedContext = useRef("");
+  const refresh = useCallback(async () => {
+    if (!supported || !service) return;
+    await usePluginManagementStore.getState().initialize({
+      workspacePath: params.workspacePath,
+      ...(identity ? { workspaceIdentity: identity } : {}),
+      pluginService: service,
+    });
+  }, [identity, params.workspacePath, service, supported]);
+  useEffect(() => {
+    if (!supported || initializedContext.current === activeContext.current) return;
+    initializedContext.current = activeContext.current;
+    void refresh();
+  }, [refresh, supported]);
+  useEffect(() => {
+    // 用户级启用是新会话的默认值。先对齐正常 build 权限，避免菜单显示原生编辑却仍运行审查。
+    if (supported && plugin?.enabled && !blocked && params.mode !== "build") {
+      params.onSwitchMode("build");
+    }
+  }, [blocked, params.mode, params.onSwitchMode, plugin?.enabled, supported]);
+
+  const select = useCallback(
+    async (value: string) => {
+      if (blocked) return;
+      if (!supported || !plugin) {
+        if (value !== CODEX_AUTO_APPROVAL_MODE) params.onSwitchMode(value);
+        return;
+      }
+      const context = activeContext.current;
+      const enabled = value === CODEX_AUTO_APPROVAL_MODE;
+      if (enabled && enableRequiresNewSession) return;
+      const success = await usePluginManagementStore
+        .getState()
+        .setEnabled(PLUGIN_ID, enabled, service, "workspace");
+      // 启停 RPC 完成时可能已切换工作区；旧请求不得再写入新草稿。
+      if (!success || activeContext.current !== context) return;
+      params.onSwitchMode(enabled ? "build" : value);
+    },
+    [blocked, enableRequiresNewSession, params.onSwitchMode, plugin, service, supported],
+  );
+
+  return {
+    visible: supported && Boolean(plugin),
+    selectedValue: supported && plugin?.enabled ? CODEX_AUTO_APPROVAL_MODE : params.mode,
+    blocked,
+    enableRequiresNewSession,
+    select,
+    refresh,
+    error: sameContext && state.lastFailedPluginId === PLUGIN_ID ? state.error : null,
+  };
+}
diff --git a/packages/ui/src/settings/CodexReviewModelControls.tsx b/packages/ui/src/settings/CodexReviewModelControls.tsx
new file mode 100755
index 0000000..6ca915e
--- /dev/null
+++ b/packages/ui/src/settings/CodexReviewModelControls.tsx
@@ -0,0 +1,162 @@
+import { useState } from "react";
+import { completeNewModelSelection } from "@zcode/provider";
+import {
+  ZCODE_AGENT_PROVIDER,
+  zcodeReviewModelSelectionSchema,
+  type ZCodeReviewModelSelection,
+  type ZCodePluginInfo,
+  type ZCodePluginScope,
+} from "@zcode/shared";
+import type { IModelSelectionService, IPluginManagementService } from "@zcode/services";
+import { ModelConfigSelect } from "@/ModelConfigSelect.js";
+import { Button } from "@/components/ui/button.js";
+import { useModelSelectionServiceView } from "@/hooks/useModelSelectionView.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+import { buildRegistryModelSelectGroups } from "@/lib/modelSelectionGroups.js";
+import { resolveModelThoughtOption } from "@/lib/modelThoughtOption.js";
+import { formatModelPickerValue, parseModelPickerValue } from "@/lib/zcodeSessionProjection.js";
+import { SettingsScopeBadge } from "@/settings/SettingsScopeBadge.js";
+import { SubagentReasoningField } from "@/settings/SubagentReasoningField.js";
+import { usePluginManagementStore } from "@/store/pluginManagementStore.js";
+
+/** 插件配置是唯一事实；此组件只保留尚未提交的编辑草稿。 */
+export function CodexReviewModelControls({
+  plugin,
+  scope,
+  modelService,
+  pluginService,
+  onManageModels,
+}: {
+  plugin: ZCodePluginInfo;
+  scope: ZCodePluginScope;
+  modelService: IModelSelectionService;
+  pluginService: IPluginManagementService;
+  onManageModels?: () => void;
+}) {
+  const { intl } = useZCodeIntl();
+  const { state } = useModelSelectionServiceView(modelService);
+  const view = state.status === "ready" ? state.view : null;
+  const [draft, setDraft] = useState<ZCodeReviewModelSelection | null>(null);
+  const configure = usePluginManagementStore((store) => store.configurePlugin);
+  const saving = usePluginManagementStore(
+    (store) => store.operationId === `plugin:configure:${plugin.id}`,
+  );
+  const rawSaved = plugin.configuredOptions?.reviewModel;
+  const saved = zcodeReviewModelSelectionSchema.safeParse(rawSaved);
+  const invalidSaved = rawSaved !== undefined && !saved.success && draft === null;
+  const selection: ZCodeReviewModelSelection =
+    draft ?? (saved.success ? saved.data : { mode: "inherit" });
+  const groups = view ? buildRegistryModelSelectGroups(ZCODE_AGENT_PROVIDER, view) : [];
+  const value = selection.mode === "specified" ? formatModelPickerValue(selection) : "inherit";
+  const thought =
+    selection.mode === "specified" && view
+      ? resolveModelThoughtOption({
+          modelSelectionView: view,
+          providerId: selection.providerId,
+          modelId: selection.modelId,
+          currentValue: selection.options?.reasoningLevel,
+        })
+      : null;
+  const text = (id: string) => intl.formatMessage({ id });
+  return (
+    <div
+      className="mt-3 grid gap-2 border-t border-border pt-3"
+      data-testid="codex-review-model-config"
+      data-config-scope={scope}
+      data-review-model-mode={selection.mode}
+      data-review-provider-id={selection.mode === "specified" ? selection.providerId : undefined}
+      data-review-model-id={selection.mode === "specified" ? selection.modelId : undefined}
+      data-review-reasoning={
+        selection.mode === "specified" ? selection.options?.reasoningLevel : undefined
+      }
+    >
+      <div className="flex items-center gap-2 text-ui-base font-medium">
+        {text("settings.plugins.reviewModel.title")}
+        <SettingsScopeBadge scope={plugin.optionSources?.reviewModel ?? "default"} />
+      </div>
+      <div className="flex flex-wrap items-center gap-2">
+        <ModelConfigSelect
+          modelGroups={groups}
+          labelVisibilityClassName="inline-flex"
+          normalizedValue={invalidSaved ? "invalid" : value}
+          triggerLabel={
+            invalidSaved
+              ? text("settings.plugins.reviewModel.invalid")
+              : selection.mode === "inherit"
+                ? text("settings.plugins.reviewModel.inherit")
+                : selection.modelId
+          }
+          showManageModelsAction={Boolean(onManageModels)}
+          onManageModels={onManageModels}
+          manageModelsLabel={intl.formatMessage({ id: "chat.toolbar.model.manageModels" })}
+          lockReasonMessage=""
+          isItemLocked={() => false}
+          disabled={saving}
+          footerActions={[
+            {
+              key: "inherit",
+              label: text("settings.plugins.reviewModel.inherit"),
+              selected: selection.mode === "inherit",
+              onSelect: () => setDraft({ mode: "inherit" }),
+            },
+          ]}
+          onValueChange={(next) => {
+            if (!view) return;
+            const chosen = completeNewModelSelection(view, parseModelPickerValue(next));
+            if (chosen)
+              setDraft({
+                mode: "specified",
+                providerId: chosen.providerId,
+                modelId: chosen.modelId,
+                ...(chosen.options?.reasoningLevel
+                  ? { options: { reasoningLevel: chosen.options.reasoningLevel } }
+                  : {}),
+              });
+          }}
+        />
+        <SubagentReasoningField
+          intl={intl}
+          disabled={saving}
+          labelVisibilityClassName="inline-flex"
+          state={thought ? { kind: "supported", option: thought } : { kind: "not-applicable" }}
+          onValueCommit={(reasoningLevel) => {
+            if (selection.mode === "specified")
+              setDraft({ ...selection, options: { reasoningLevel } });
+          }}
+        />
+        {scope === "workspace" && plugin.optionSources?.reviewModel === "workspace" ? (
+          <Button
+            data-testid="codex-review-model-restore"
+            variant="ghost"
+            disabled={saving}
+            onClick={async () => {
+              if (await configure(plugin.id, {}, pluginService, scope, ["reviewModel"]))
+                setDraft(null);
+            }}
+          >
+            {intl.formatMessage({ id: "settings.plugins.config.restoreOption" })}
+          </Button>
+        ) : null}
+        <Button
+          data-testid="codex-review-model-save"
+          variant="outline"
+          disabled={saving || !draft}
+          onClick={async () => {
+            if (draft && (await configure(plugin.id, { reviewModel: draft }, pluginService, scope)))
+              setDraft(null);
+          }}
+        >
+          {intl.formatMessage({ id: "settings.plugins.config.save" })}
+        </Button>
+      </div>
+      {invalidSaved ? (
+        <p role="alert" className="text-ui-sm text-destructive">
+          {text("settings.plugins.reviewModel.invalid")}
+        </p>
+      ) : null}
+      <p className="text-ui-sm text-foreground-subtle">
+        {text("settings.plugins.reviewModel.description")}
+      </p>
+    </div>
+  );
+}
diff --git a/packages/ui/src/v4/PermissionReviewStatus.tsx b/packages/ui/src/v4/PermissionReviewStatus.tsx
new file mode 100755
index 0000000..32ecd1e
--- /dev/null
+++ b/packages/ui/src/v4/PermissionReviewStatus.tsx
@@ -0,0 +1,62 @@
+import type { ToolCallRow } from "@zcode/shared/zcode-protocol-v4";
+import {
+  Tooltip,
+  TooltipContent,
+  TooltipProvider,
+  TooltipTrigger,
+} from "@/components/ui/tooltip.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+
+export function PermissionReviewStatus({ row }: { row: ToolCallRow }) {
+  const { intl } = useZCodeIntl();
+  const review = row.permissionReview;
+  if (!review) return null;
+  const reviewing = review.status === "reviewing";
+  // 旧进度不能覆盖终态工具；已完成审查是持久化事实，工具完成后仍需显示实际模型。
+  if (reviewing && ["success", "error", "cancelled"].includes(row.status)) return null;
+  const labels = {
+    reviewing: "chat.permission.autoReviewing",
+    allow: "chat.permission.autoReviewAllowed",
+    deny: "chat.permission.autoReviewDenied",
+    failed: "chat.permission.autoReviewFailedShort",
+    cancelled: "chat.permission.autoReviewCancelled",
+  };
+  const model = review.actualReviewModel;
+  const status = (
+    <p
+      role="status"
+      tabIndex={model ? 0 : undefined}
+      data-testid={reviewing ? "auto-review-progress" : "auto-review-result"}
+      data-review-status={review.status}
+      data-review-provider-id={model?.providerId}
+      data-review-model-id={model?.modelId}
+      data-review-reasoning={model?.options?.reasoningLevel}
+      className={`text-ui-caption text-foreground-subtle${reviewing ? " animate-pulse" : ""}`}
+    >
+      {intl.formatMessage({ id: labels[review.status] })}
+      {model ? ` · ${model.modelId}` : ""}
+    </p>
+  );
+  if (!model) return status;
+  return (
+    <TooltipProvider>
+      <Tooltip>
+        <TooltipTrigger asChild>{status}</TooltipTrigger>
+        <TooltipContent data-testid="auto-review-model-details" className="flex-col items-start">
+          <span>
+            {intl.formatMessage({ id: "chat.permission.reviewProvider" })}: {model.providerId}
+          </span>
+          <span>
+            {intl.formatMessage({ id: "chat.permission.reviewModel" })}: {model.modelId}
+          </span>
+          {model.options?.reasoningLevel ? (
+            <span>
+              {intl.formatMessage({ id: "chat.permission.reviewReasoning" })}:{" "}
+              {model.options.reasoningLevel}
+            </span>
+          ) : null}
+        </TooltipContent>
+      </Tooltip>
+    </TooltipProvider>
+  );
+}
