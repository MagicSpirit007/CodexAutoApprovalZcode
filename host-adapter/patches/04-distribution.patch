@@ -0,0 +1,34 @@
+import { readFileSync } from "node:fs";
+import { resolve } from "node:path";
+
+export function readAutoReviewRelease(env = process.env) {
+  const file = env.ZCODE_AUTOREVIEW_RELEASE_FILE?.trim();
+  if (!file) return null;
+  const info = JSON.parse(readFileSync(resolve(file), "utf8"));
+  const acceptance = env.ZCODE_AUTOREVIEW_TEST_BUILD === "1";
+  const stable = /^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)$/;
+  // 编译输入必须明确标记独立发行，防止错误配置生成能覆盖官方安装的包。
+  if (
+    info.schemaVersion !== 1 ||
+    info.applicationId !==
+      (acceptance ? "dev.codexautoreview.zcode.acceptance" : "dev.codexautoreview.zcode") ||
+    info.productName !== (acceptance ? "ZCode AutoReview Acceptance" : "ZCode AutoReview") ||
+    info.executableName !== "ZCodeAutoReview" ||
+    !stable.test(info.distributionVersion) ||
+    info.dataSchemaChanged !== false ||
+    !stable.test(info.upstreamVersion) ||
+    !/^[a-f0-9]{40}$/.test(info.upstreamCommit) ||
+    info.bridgeProtocol !== 2 ||
+    !stable.test(info.pluginVersion) ||
+    !Array.isArray(info.supportedPluginVersions) ||
+    !info.supportedPluginVersions.length ||
+    !info.supportedPluginVersions.every(version => typeof version === "string" && stable.test(version)) ||
+    !info.supportedPluginVersions.includes(info.pluginVersion) ||
+    info.repository !== "MagicSpirit007/CodexAutoApprovalZcode" ||
+    info.updateFeedUrl !==
+      `https://raw.githubusercontent.com/${info.repository}/main/updates/windows-x64/stable/`
+  ) {
+    throw new Error("Invalid AutoReview stable release configuration");
+  }
+  return Object.freeze(info);
+}
