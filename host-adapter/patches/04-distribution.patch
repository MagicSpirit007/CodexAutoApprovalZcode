+import type { AutoReviewRelease } from "@zcode/shared";
+
+declare const __ZCODE_AUTOREVIEW_RELEASE__: AutoReviewRelease | null;
+declare const __ZCODE_AUTOREVIEW_TEST_BUILD__: boolean;
+// 生产身份只能来自编译输入；不接受工作区或继承环境改变更新仓库和应用身份。
+export const autoReviewRelease: Readonly<AutoReviewRelease> | null =
+  typeof __ZCODE_AUTOREVIEW_RELEASE__ === "undefined" ? null : __ZCODE_AUTOREVIEW_RELEASE__;
+export const autoReviewTestBuild =
+  typeof __ZCODE_AUTOREVIEW_TEST_BUILD__ !== "undefined" && __ZCODE_AUTOREVIEW_TEST_BUILD__;
diff --git a/packages/desktop/src/main/autoReviewUpdateProvider.ts b/packages/desktop/src/main/autoReviewUpdateProvider.ts
new file mode 100755
index 0000000..5eb6e84
--- /dev/null
+++ b/packages/desktop/src/main/autoReviewUpdateProvider.ts
@@ -0,0 +1,120 @@
+import { readFile } from "node:fs/promises";
+import { join } from "node:path";
+import { getDataBaseDir } from "@zcode/services/node";
+import { validateAutoReviewUpdate, type AutoReviewUpdateManifest } from "@zcode/shared";
+import { type AppUpdater, type UpdateInfo, type ResolvedUpdateFileInfo } from "electron-updater";
+import { Provider } from "electron-updater/out/providers/Provider.js";
+import type { CustomPublishOptions } from "builder-util-runtime";
+import type { ProviderRuntimeOptions } from "electron-updater/out/providers/Provider.js";
+import { parse } from "yaml";
+import { autoReviewRelease, autoReviewTestBuild } from "./autoReviewRelease.js";
+import { verifyAutoReviewInstallerIntegrity } from "./autoReviewInstallerIntegrity.js";
+
+interface Options extends CustomPublishOptions {
+  url: string;
+}
+
+async function installedCodexVersions(): Promise<string[]> {
+  const file = join(getDataBaseDir(), ".zcode", "cli", "plugins", "installed_plugins.json");
+  let raw: string;
+  try {
+    raw = await readFile(file, "utf8");
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT") return [];
+    throw error;
+  }
+  const state = JSON.parse(raw) as { plugins?: Array<{ name: string; version: string }> };
+  if (!Array.isArray(state.plugins)) throw new Error("Cannot verify installed plugin versions");
+  return state.plugins
+    .filter((plugin) => plugin.name === "codex-auto-approval")
+    .map((plugin) => plugin.version);
+}
+
+/** 只接独立稳定清单；metadata 校验先于 electron-updater 的版本与下载事件。 */
+export class AutoReviewUpdateProvider extends Provider<UpdateInfo> {
+  private readonly baseUrl: URL;
+  private readonly validated = new Map<string, AutoReviewUpdateManifest>();
+  constructor(options: Options, _updater: AppUpdater, runtime: ProviderRuntimeOptions) {
+    super(runtime);
+    if (!autoReviewRelease) throw new Error("AutoReview release identity missing");
+    const productionUrl = autoReviewRelease.updateFeedUrl;
+    if (options.url !== productionUrl && !autoReviewTestBuild)
+      throw new Error("AutoReview feed override rejected");
+    this.baseUrl = new URL(options.url);
+    if (
+      autoReviewTestBuild &&
+      options.url !== productionUrl &&
+      !["127.0.0.1", "localhost"].includes(this.baseUrl.hostname)
+    ) {
+      throw new Error("Acceptance feed must be loopback");
+    }
+  }
+  async getLatestVersion(): Promise<UpdateInfo> {
+    const info: unknown = parse(
+      (await this.httpRequest(new URL("latest.yml", this.baseUrl))) ?? "",
+    );
+    validateAutoReviewUpdate(
+      info,
+      autoReviewRelease!,
+      await installedCodexVersions(),
+      autoReviewTestBuild ? this.baseUrl.origin : undefined,
+    );
+    const previous = this.validated.get(info.version);
+    if (previous && JSON.stringify(previous) !== JSON.stringify(info)) {
+      throw new Error("Published AutoReview release metadata changed for the same version");
+    }
+    this.validated.set(info.version, info);
+    return {
+      ...info,
+      path: info.files[0]!.url,
+      sha512: info.files[0]!.sha512,
+      releaseDate: (info as unknown as { releaseDate?: string }).releaseDate ?? "",
+      releaseName: `ZCode AutoReview ${info.version} (ZCode ${info.autoReview.upstreamVersion})`,
+      zcodeReleaseChannel: "stable",
+    } as UpdateInfo;
+  }
+  async revalidate(version: string, installerFile?: string): Promise<void> {
+    const info = this.validated.get(version);
+    if (!info) throw new Error("Selected update has no validated release metadata");
+    validateAutoReviewUpdate(
+      info,
+      autoReviewRelease!,
+      await installedCodexVersions(),
+      autoReviewTestBuild ? this.baseUrl.origin : undefined,
+    );
+    if (installerFile) await verifyAutoReviewInstallerIntegrity(installerFile, info.files[0]!);
+  }
+  compatiblePluginVersions(version: string): string[] {
+    const info = this.validated.get(version);
+    if (!info) throw new Error("Selected update compatibility is unavailable");
+    return [...info.autoReview.supportedPluginVersions];
+  }
+  resolveFiles(info: UpdateInfo): ResolvedUpdateFileInfo[] {
+    validateAutoReviewUpdate(
+      info,
+      autoReviewRelease!,
+      [],
+      autoReviewTestBuild ? this.baseUrl.origin : undefined,
+    );
+    return info.files.map((file) => ({
+      url: new URL(file.url),
+      info: { ...file, url: new URL(file.url).pathname.split("/").pop()! },
+    }));
+  }
+}
+
+let activeProvider: AutoReviewUpdateProvider | null = null;
+export class ActiveAutoReviewUpdateProvider extends AutoReviewUpdateProvider {
+  constructor(options: Options, updater: AppUpdater, runtime: ProviderRuntimeOptions) {
+    super(options, updater, runtime);
+    activeProvider = this;
+  }
+}
+export async function revalidateAutoReviewUpdate(version: string, installerFile?: string): Promise<void> {
+  if (!activeProvider) throw new Error("AutoReview update provider unavailable");
+  await activeProvider.revalidate(version, installerFile);
+}
+export function autoReviewUpdateCompatiblePluginVersions(version: string): string[] {
+  if (!activeProvider) throw new Error("AutoReview update provider unavailable");
+  return activeProvider.compatiblePluginVersions(version);
+}
