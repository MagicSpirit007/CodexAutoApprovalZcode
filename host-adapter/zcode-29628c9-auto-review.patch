+import { z } from "zod";
+
+/** References only: native provider management remains the credential owner. */
+export const reviewModelSelectionSchema = z.discriminatedUnion("mode", [
+  z.object({ mode: z.literal("inherit") }).strict(),
+  z.object({
+    mode: z.literal("specified"),
+    providerId: z.string().trim().min(1).max(200),
+    modelId: z.string().trim().min(1).max(200),
+    options: z.object({ reasoningLevel: z.string().trim().min(1).max(80) }).strict().optional(),
+  }).strict(),
+]);
+export type ReviewModelSelection = z.infer<typeof reviewModelSelectionSchema>;
