+import type { HookJSONOutput, PermissionRequestHookInput, HookPluginContext } from "../hooks/index.js";
+
+/** Native credentials and model handles never cross this boundary. */
+export interface ApprovalBridgeOwner {
+  snapshot(): unknown;
+  complete(params: unknown, signal: AbortSignal): Promise<unknown>;
+  record(outcome: "allow" | "deny", assessment: unknown, input: PermissionRequestHookInput): boolean;
+}
+
+export interface ApprovalBridgeLease {
+  env: Record<string, string>;
+  finish(output: HookJSONOutput | undefined): HookJSONOutput;
+  close(): Promise<void>;
+}
+
+export interface ApprovalBridgePort {
+  open(input: PermissionRequestHookInput, signal?: AbortSignal, plugin?: HookPluginContext): Promise<ApprovalBridgeLease>;
+}
+
+export type ApprovalBridgeFactory = (owner: ApprovalBridgeOwner) => ApprovalBridgePort;
diff --git a/apps/zcode-cli/packages/core/src/runtime/helpers/approval-bridge.ts b/apps/zcode-cli/packages/core/src/runtime/helpers/approval-bridge.ts
new file mode 100755
index 0000000..c634b3c
--- /dev/null
+++ b/apps/zcode-cli/packages/core/src/runtime/helpers/approval-bridge.ts
@@ -0,0 +1,90 @@
+import type { ApprovalBridgeFactory, ApprovalBridgePort, ModelInputMessage, ModelToolContract } from "@zcode/contracts";
+import { ModelRetryBudget } from "@zcode/contracts";
+import type { AgentRuntimeInternal } from "../internal.js";
+import { createTurnModel } from "../methods/turn-model.js";
+import { ProviderEntryOrigins } from "./provider-entry-origins.js";
+
+const REVIEW_MAX_OUTPUT_TOKENS = 8192;
+
+function visibleMessage(message: ModelInputMessage) {
+  return { role: message.role,
+    content: typeof message.content === "string" ? message.content : message.content.filter(block => block.type === "text"),
+    ...(message.toolCalls ? { tool_calls: message.toolCalls.map(call => ({ id: call.id,
+      type: "function", function: { name: call.name, arguments: JSON.stringify(call.input) } })) } : {}),
+    ...(message.toolCallId ? { tool_call_id: message.toolCallId } : {}) };
+}
+
+/** Runtime owns denials; the adapter owns only short-lived transport leases. */
+export function createRuntimeApprovalBridge(runtime: AgentRuntimeInternal, factory: ApprovalBridgeFactory): ApprovalBridgePort {
+  let turnId: string | undefined;
+  let consecutive = 0;
+  let window: boolean[] = [];
+  let denials: unknown[] = [];
+  let interrupted = false;
+  const port = factory({
+    snapshot() {
+      const entries = runtime.messageHistory.borrowReadOnlyRuntimeEntries()
+        .filter(entry => entry.kind !== "attachment");
+      const messages = entries.map(entry => visibleMessage(entry.message));
+      const origins = new ProviderEntryOrigins();
+      const userMessages = entries.filter(entry => origins.hasRealUser(entry))
+        .map(entry => visibleMessage(entry.message).content);
+      const selection = runtime.getSessionModelSelection();
+      if (!selection) throw new Error("Select a desktop model before automatic review");
+      return { workspace: runtime.workingDirectory, modelSnapshot: selection,
+        branchGeneration: runtime.branchGeneration, mode: runtime.config.mode,
+        sessionId: runtime.sessionId, turnId, interrupted,
+        state: { userMessages, messages: messages.slice(-24), denials } };
+    },
+    async complete(params, signal) {
+      signal.throwIfAborted();
+      if (interrupted) throw new Error("Approval circuit breaker stopped this turn");
+      const request = params as { messages?: unknown[]; tools?: { name: string; description: string; parameters: unknown }[] };
+      if (!Array.isArray(request.messages) || JSON.stringify(request.messages).length > 180000) throw new Error("Approval input budget exceeded");
+      if (!Array.isArray(request.tools) || request.tools.length !== 2 || request.tools.some(tool => !["read_file", "list_files"].includes(tool.name))) {
+        throw new Error("Approval model may only investigate files and directories");
+      }
+      const messages: ModelInputMessage[] = request.messages.map(value => {
+        const message = value as { role: ModelInputMessage["role"]; content: string; tool_call_id?: string;
+          tool_calls?: { id: string; function: { name: string; arguments: string } }[] };
+        if (!["system", "user", "assistant", "tool"].includes(message.role) || typeof message.content !== "string") throw new Error("Invalid review message");
+        return { role: message.role, content: message.content,
+          ...(message.tool_call_id ? { toolCallId: message.tool_call_id } : {}),
+          ...(message.tool_calls ? { toolCalls: message.tool_calls.map(call => {
+            if (!["read_file", "list_files"].includes(call.function.name)) throw new Error("Invalid investigation tool");
+            return { id: call.id, name: call.function.name, input: JSON.parse(call.function.arguments) };
+          }) } : {}) };
+      });
+      const tools: ModelToolContract[] = request.tools.map(tool => ({
+        name: tool.name, description: tool.description, inputSchema: tool.parameters as ModelToolContract["inputSchema"],
+        readOnly: true, destructive: false,
+      }));
+      const model = createTurnModel(runtime, { retryBudget: ModelRetryBudget.SingleAttempt });
+      // 原生工厂只绑定会话推理档位；输出预算必须逐次提供，否则在请求发送前即被校验拒绝。
+      const result = await model.generateText({ messages, tools, abortSignal: signal,
+        options: { maxOutputTokens: Math.min(REVIEW_MAX_OUTPUT_TOKENS, model.optionSpecs.maxOutputTokens.max) } });
+      // Main-model and reviewer hidden reasoning never cross the approval bridge.
+      return { role: "assistant", content: result.text,
+        ...(result.toolCalls?.length ? { tool_calls: result.toolCalls.map(call => ({ id: call.id,
+          type: "function", function: { name: call.name, arguments: JSON.stringify(call.input) } })) } : {}) };
+    },
+    record(outcome, assessment, input) {
+      const denied = outcome === "deny";
+      window = [...window, denied].slice(-50);
+      consecutive = denied ? consecutive + 1 : 0;
+      if (denied) denials = [...denials, { assessment, turnId: input.turnId,
+        toolCallId: input.toolCallId, action: { tool: input.toolName, arguments: input.toolInput } }].slice(-50);
+      interrupted ||= consecutive >= 3 || window.filter(Boolean).length >= 10;
+      return interrupted;
+    },
+  });
+  return {
+    open(input, signal, plugin) {
+      if (turnId !== input.turnId) {
+        turnId = input.turnId;
+        consecutive = 0; window = []; interrupted = false;
+      }
+      return port.open(input, signal, plugin);
+    },
+  };
+}
