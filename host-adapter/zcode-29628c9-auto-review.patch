@@ -0,0 +1,49 @@
+import { z } from "zod";
+
+export const ApprovalAssessmentSchema = z.object({
+  outcome: z.enum(["allow", "deny"]),
+  risk_level: z.enum(["low", "medium", "high", "critical"]),
+  user_authorization: z.enum(["unknown", "low", "medium", "high"]),
+  rationale: z.string(),
+});
+
+export type ApprovalAssessment = z.infer<typeof ApprovalAssessmentSchema>;
+
+export const ApprovalReviewFailureSchema = z.object({
+  code: z.string().max(80), message: z.string().max(2000),
+  businessCode: z.string().max(80).optional(), httpStatus: z.number().int().min(100).max(599).optional(),
+  requestId: z.string().max(160).optional(), retryAfterMs: z.number().int().min(0).max(90000).optional(),
+  retryable: z.boolean().optional(),
+});
+export type ApprovalReviewFailure = z.infer<typeof ApprovalReviewFailureSchema>;
+
+/** Provider exceptions can contain headers/bodies: expose only a bounded redacted message. */
+export function approvalReviewFailure(error: unknown): ApprovalReviewFailure {
+  const value = error as { code?: string; name?: string; message?: string; businessCode?: string; providerCode?: string | number;
+    httpStatus?: number; statusCode?: number; responseStatus?: number; requestId?: string; providerRequestId?: string;
+    retryAfterMs?: number; retryable?: boolean; isRetryable?: boolean } | undefined;
+  const code = value?.name === "ProviderBusinessError" ? "provider_business_error" : value?.code ?? (value?.name === "TimeoutError" ? "timeout" : "review_error");
+  const redact = (field: unknown) => String(field)
+    .replace(/\bsk-[a-zA-Z0-9_-]+/g, "[redacted]")
+    .replace(/(?:Bearer\s+)[^\s,;]+/gi, "Bearer [redacted]")
+    .replace(/((?:api[_-]?key|authorization|token|password|secret)[\s"']*[:=][\s"']*)[^\s"',;}]+/gi, "$1[redacted]")
+    .replace(/https?:\/\/[^\s]+/gi, "[endpoint]")
+    .split("\n")[0]!;
+  const message = redact(value?.message ?? "Automatic review unavailable").slice(0, 2000);
+  const safeId = (field: unknown, limit: number) => redact(field).replace(/[^a-zA-Z0-9_.-]/g, "_").slice(0, limit);
+  const businessCode = value?.businessCode ?? value?.providerCode;
+  const httpStatus = value?.httpStatus ?? value?.responseStatus ?? value?.statusCode;
+  const requestId = value?.requestId ?? value?.providerRequestId;
+  return { code: safeId(code, 80), message,
+    ...(businessCode !== undefined ? { businessCode: safeId(businessCode, 80) } : {}),
+    ...(Number.isInteger(httpStatus) && httpStatus! >= 100 && httpStatus! <= 599 ? { httpStatus } : {}),
+    ...(requestId ? { requestId: safeId(requestId, 160) } : {}),
+    ...(Number.isFinite(value?.retryAfterMs) ? { retryAfterMs: Math.min(90000, Math.max(0, Math.floor(value!.retryAfterMs!))) } : {}),
+    retryable: value?.name !== "ProviderBusinessError" && (value?.retryable === true || value?.isRetryable === true),
+  };
+}
+
+export const approvalBindingFields = {
+  bindingId: z.string().optional(),
+  assessment: ApprovalAssessmentSchema.optional(),
+};
