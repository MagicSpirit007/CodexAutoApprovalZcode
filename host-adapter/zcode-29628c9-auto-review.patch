@@ -0,0 +1,148 @@
+import type { ApprovalBridgeFactory, ApprovalBridgePort, ModelInputMessage, ModelToolContract, ModelReasoningContentBlock } from "@zcode/contracts";
+import { approvalReviewFailure, createChildTraceContext, runWithModelInvocationContext, traceContextToLogContext, ModelRetryBudget } from "@zcode/contracts";
+import type { AgentRuntimeInternal } from "../internal.js";
+import { createTurnModel } from "../methods/turn-model.js";
+import { ProviderEntryOrigins } from "./provider-entry-origins.js";
+
+import { ApprovalContinuation, mergeReasoningMetadata } from "./approval-continuation.js";
+
+const REVIEW_MAX_OUTPUT_TOKENS = 8192;
+
+function visibleMessage(message: ModelInputMessage) {
+  return { role: message.role,
+    content: typeof message.content === "string" ? message.content : message.content.filter(block => block.type === "text").map(block => ({ type: "text", text: block.text })),
+    ...(message.toolCalls ? { tool_calls: message.toolCalls.map(call => ({ id: call.id,
+      type: "function", function: { name: call.name, arguments: JSON.stringify(call.input) } })) } : {}),
+    ...(message.toolCallId ? { tool_call_id: message.toolCallId } : {}) };
+}
+
+/** Runtime owns denials; the adapter owns only short-lived transport leases. */
+export function createRuntimeApprovalBridge(runtime: AgentRuntimeInternal, factory: ApprovalBridgeFactory): ApprovalBridgePort {
+  let turnId: string | undefined;
+  let consecutive = 0;
+  let window: boolean[] = [];
+  let denials: unknown[] = [];
+  let interrupted = false;
+  const continuation = new ApprovalContinuation();
+  const port = factory({
+    clearContinuation: bindingId => continuation.clear(bindingId),
+    snapshot() {
+      const entries = runtime.messageHistory.borrowReadOnlyRuntimeEntries()
+        .filter(entry => entry.kind !== "attachment");
+      const messages = entries.map(entry => visibleMessage(entry.message));
+      const origins = new ProviderEntryOrigins();
+      const userMessages = entries.filter(entry => origins.hasRealUser(entry))
+        .map(entry => visibleMessage(entry.message).content);
+      const selection = runtime.getSessionModelSelection();
+      if (!selection) throw new Error("Select a desktop model before automatic review");
+      return { workspace: runtime.workingDirectory, workspaceIdentity: runtime.config.workspaceIdentity?.trim() || runtime.config.memory?.workspaceIdentity?.trim() || runtime.workingDirectory, modelSnapshot: selection,
+        branchGeneration: runtime.branchGeneration, mode: runtime.config.mode,
+        sessionId: runtime.sessionId, turnId, interrupted,
+        state: { userMessages, messages: messages.slice(-24), denials } };
+    },
+    async complete(params, signal, input, binding) {
+      signal.throwIfAborted();
+      if (interrupted) throw new Error("Approval circuit breaker stopped this turn");
+      const request = params as { messages?: unknown[]; tools?: { name: string; description: string; parameters: unknown }[] };
+      if (!Array.isArray(request.messages) || JSON.stringify(request.messages).length > 180000) throw new Error("Approval input budget exceeded");
+      if (!Array.isArray(request.tools) || request.tools.length !== 2 || new Set(request.tools.map(tool => tool.name)).size !== 2 || request.tools.some(tool => !["read_file", "list_files"].includes(tool.name))) {
+        throw new Error("Approval model may only investigate files and directories");
+      }
+      const messages: ModelInputMessage[] = request.messages.map(value => {
+        if (!value || typeof value !== "object" || Object.keys(value).some(key => !["role", "content", "tool_call_id", "tool_calls"].includes(key))) throw new Error("Review messages may not supply private model state");
+        const message = value as { role: ModelInputMessage["role"]; content: string; tool_call_id?: string;
+          tool_calls?: { id: string; function: { name: string; arguments: string } }[] };
+        if (!["system", "user", "assistant", "tool"].includes(message.role) || typeof message.content !== "string") throw new Error("Invalid review message");
+        return { role: message.role, content: message.content,
+          ...(message.tool_call_id ? { toolCallId: message.tool_call_id } : {}),
+          ...(message.tool_calls ? { toolCalls: message.tool_calls.map(call => {
+            if (!["read_file", "list_files"].includes(call.function.name)) throw new Error("Invalid investigation tool");
+            if (Object.keys(call).some(key => !["id", "type", "function"].includes(key)) || Object.keys(call.function).some(key => !["name", "arguments"].includes(key))) throw new Error("Review tool calls may not supply provider metadata");
+            return { id: call.id, name: call.function.name, input: JSON.parse(call.function.arguments) };
+          }) } : {}) };
+      });
+      const tools: ModelToolContract[] = request.tools.map(tool => ({
+        name: tool.name, description: tool.description, inputSchema: tool.parameters as ModelToolContract["inputSchema"],
+        readOnly: true, destructive: false,
+      }));
+      const model = createTurnModel(runtime, { selection: binding?.reviewSelection, retryBudget: ModelRetryBudget.SingleAttempt });
+      if (!model.properties.supportsToolCall) throw Object.assign(new Error("Review model must support read-only tools"), { code: "review_model_incompatible" });
+      const bindingId = binding?.bindingId ?? input.requestId;
+      const attempt = binding?.attempt ?? 1;
+      const nativeMessages = continuation.restore(bindingId, attempt, request.messages, messages);
+      const reasoning = new Map<string, ModelReasoningContentBlock>();
+      // 原生工厂只绑定会话推理档位；输出预算必须逐次提供，否则在请求发送前即被校验拒绝。
+      // Socket callbacks have no reliable ambient context. Bind attribution before entering native streaming.
+      const traceContext = createChildTraceContext(input.traceContext ?? runtime.rootTraceContext, {
+        sessionId: input.sessionId, turnId: input.turnId,
+        attributes: { querySource: "auto_review", toolCallId: String(input.toolCallId), requestId: input.requestId },
+      });
+      const result = { text: "", toolCalls: [] as NonNullable<ModelInputMessage["toolCalls"]> };
+      let finished = false;
+      let providerOptions: Record<string, unknown> | undefined;
+      await runWithModelInvocationContext({
+        traceContext, metadata: { ...traceContextToLogContext(traceContext), querySource: "auto_review" },
+        modelRequestSessionType: "other", modelCall: { operation: "workspace_generate_text" },
+      }, async () => {
+        for await (const event of model.streamText({ messages: nativeMessages, tools, abortSignal: signal,
+          options: { maxOutputTokens: Math.min(REVIEW_MAX_OUTPUT_TOKENS, model.optionSpecs.maxOutputTokens.max) } })) {
+          signal.throwIfAborted();
+          if (event.type === "error") {
+            if (event.error instanceof Error) throw event.error;
+            const failure = approvalReviewFailure(typeof event.error === "string" ? { message: event.error } : event.error);
+            throw Object.assign(new Error(failure.message), failure);
+          }
+          if (event.type === "reasoning_start" || event.type === "reasoning_delta" || event.type === "reasoning_end") {
+            const key = event.id ?? "default";
+            const block = reasoning.get(key) ?? { type: "reasoning" as const, text: "" };
+            if (event.type === "reasoning_delta") block.text += event.text;
+            mergeReasoningMetadata(block, event.providerMetadata);
+            reasoning.set(key, block);
+          }
+          if (event.type === "text_delta") result.text += event.text;
+          if (event.type === "tool_call") result.toolCalls.push(event.toolCall);
+          if (event.type === "finish") {
+            if (!["stop", "tool-calls", "tool_calls", "end_turn"].includes(event.finishReason)) {
+              throw Object.assign(new Error(`Review stream stopped with ${event.finishReason}`), { code: "incomplete_output" });
+            }
+            providerOptions = event.providerMetadata ? Object.fromEntries(Object.entries(event.providerMetadata)
+              .filter(([, value]) => typeof value === "object" && value !== null && !Array.isArray(value))) : undefined;
+            finished = true;
+          }
+        }
+      });
+      if (!finished) throw Object.assign(new Error("Automatic review stream ended before finish"), { code: "missing_finish" });
+      // Main-model and reviewer hidden reasoning never cross the approval bridge.
+      const output = { role: "assistant", content: result.text,
+        ...(result.toolCalls?.length ? { tool_calls: result.toolCalls.map(call => ({ id: call.id,
+          type: "function", function: { name: call.name, arguments: JSON.stringify(call.input) } })) } : {}) };
+      signal.throwIfAborted();
+      continuation.save(bindingId, attempt, request.messages, nativeMessages, output, {
+        role: "assistant", content: [...reasoning.values(), { type: "text", text: result.text }],
+        ...(result.toolCalls.length ? { toolCalls: result.toolCalls } : {}),
+        providerId: model.providerId, modelId: model.modelId, providerOptions,
+      });
+      return output;
+    },
+    record(outcome, assessment, input) {
+      const denied = outcome === "deny";
+      window = [...window, denied].slice(-50);
+      consecutive = denied ? consecutive + 1 : 0;
+      if (denied) denials = [...denials, { assessment, turnId: input.turnId,
+        toolCallId: input.toolCallId, action: { tool: input.toolName, arguments: input.toolInput } }].slice(-50);
+      interrupted ||= consecutive >= 3 || window.filter(Boolean).length >= 10;
+      return interrupted;
+    },
+  });
+  return {
+    isActive: port.isActive,
+    reviewModel: port.reviewModel,
+    open(input, signal, plugin, onReviewModel) {
+      if (turnId !== input.turnId) {
+        turnId = input.turnId;
+        consecutive = 0; window = []; interrupted = false;
+      }
+      return port.open(input, signal, plugin, onReviewModel);
+    },
+  };
+}
diff --git a/apps/zcode-cli/packages/core/src/runtime/helpers/approval-continuation.ts b/apps/zcode-cli/packages/core/src/runtime/helpers/approval-continuation.ts
new file mode 100755
index 0000000..311ba6e
--- /dev/null
+++ b/apps/zcode-cli/packages/core/src/runtime/helpers/approval-continuation.ts
@@ -0,0 +1,50 @@
+import type { ModelInputMessage, ModelReasoningContentBlock } from "@zcode/contracts";
+
+type Continuation = { attempt: number; visible: unknown[]; native: ModelInputMessage[] };
+const fault = (message: string) => Object.assign(new Error(message), { code: "invalid_continuation" });
+
+/** Private runtime state; visible messages are its sole transport capability. */
+export class ApprovalContinuation {
+  readonly #bindings = new Map<string, Continuation>();
+
+  clear(bindingId: string): void { this.#bindings.delete(bindingId); }
+
+  restore(bindingId: string, attempt: number, visible: unknown[], parsed: ModelInputMessage[]): ModelInputMessage[] {
+    if (visible.length === 2) { this.clear(bindingId); return parsed; }
+    const state = this.#bindings.get(bindingId);
+    if (!state || state.attempt !== attempt || visible.length <= state.visible.length ||
+      JSON.stringify(visible.slice(0, state.visible.length)) !== JSON.stringify(state.visible)) {
+      this.clear(bindingId);
+      throw fault("Review transcript does not match its bound visible prefix");
+    }
+    const last = state.native.at(-1);
+    const suffix = parsed.slice(state.visible.length);
+    const pending = new Set(last?.toolCalls?.map(call => call.id) ?? []);
+    for (const message of suffix) {
+      if (message.role !== "tool" || !message.toolCallId || !pending.delete(message.toolCallId)) {
+        this.clear(bindingId);
+        throw fault("Review continuation may only append the pending read tool results");
+      }
+      message.toolName = last?.toolCalls?.find(call => call.id === message.toolCallId)?.name;
+    }
+    if (pending.size) { this.clear(bindingId); throw fault("Review continuation is missing a read tool result"); }
+    return [...structuredClone(state.native), ...suffix];
+  }
+
+  save(bindingId: string, attempt: number, visible: unknown[], native: ModelInputMessage[],
+    output: unknown, assistant: ModelInputMessage): void {
+    this.#bindings.set(bindingId, { attempt, visible: structuredClone([...visible, output]),
+      native: structuredClone([...native, assistant]) });
+  }
+}
+
+/** Preserve block signatures and provider metadata without sending them to the plugin. */
+export function mergeReasoningMetadata(block: ModelReasoningContentBlock, metadata?: Record<string, unknown>): void {
+  if (!metadata) return;
+  const merged = { ...block.providerOptions };
+  for (const [key, value] of Object.entries(metadata)) {
+    merged[key] = typeof value === "object" && value !== null && !Array.isArray(value)
+      ? { ...(merged[key] as Record<string, unknown> | undefined), ...value } : value;
+  }
+  block.providerOptions = merged;
+}
diff --git a/apps/zcode-cli/packages/core/src/tool/executor/permission-review-flow.ts b/apps/zcode-cli/packages/core/src/tool/executor/permission-review-flow.ts
new file mode 100755
index 0000000..3c1fdfd
--- /dev/null
+++ b/apps/zcode-cli/packages/core/src/tool/executor/permission-review-flow.ts
@@ -0,0 +1,95 @@
+import {
+  approvalReviewFailure, SessionEventType, type ApprovalReviewFailure,
+  type PermissionBrokerRequest, type PermissionBrokerResult, type PermissionUpdate,
+  type CollaborationMode, type TraceContext,
+} from "@zcode/contracts";
+import type { PermissionDecisionResult } from "../../permission/service.js";
+import type { ToolExecutorDeps } from "./types.js";
+import type { ExecutableToolCall } from "../types.js";
+import { hookMatcherToolNamesForTool } from "../compat.js";
+import { emitPermissionRequested, emitPermissionResolved } from "./events.js";
+import { runPermissionRequestHooks } from "./hook-flow.js";
+import { racePermissionResponders } from "./permission-responder-race.js";
+
+type Args = {
+  deps: ToolExecutorDeps; toolCall: ExecutableToolCall; executionInput: unknown;
+  requestId: string; permissionDecision: PermissionDecisionResult;
+  mode: CollaborationMode; traceContext: TraceContext; signal?: AbortSignal;
+  suggestedPermissionUpdates: PermissionUpdate[];
+  approval: Parameters<typeof emitPermissionRequested>[8];
+};
+
+export async function resolvePermissionResponders(args: Args): Promise<{ source: "hook" | "broker"; result: PermissionBrokerResult }> {
+  const { deps, toolCall, executionInput, requestId, permissionDecision, mode, traceContext, signal,
+    suggestedPermissionUpdates, approval } = args;
+  const automatic = deps.hookRunner?.hasAutomaticPermissionReview?.({
+    matchValue: toolCall.name, matchValues: hookMatcherToolNamesForTool(toolCall.name),
+  }) === true;
+  const publish = (failure?: ApprovalReviewFailure, once = false) => emitPermissionRequested(deps, toolCall,
+    executionInput, requestId, permissionDecision.riskLevel, permissionDecision.reason,
+    suggestedPermissionUpdates, traceContext, { ...approval, ...(failure ? { reviewFailure: failure } : {}), ...(once ? { optionsPolicy: "no-always-allow" } : {}) });
+  const broker = (brokerSignal?: AbortSignal, claimResponse?: () => boolean, failure?: ApprovalReviewFailure, once = false) =>
+    deps.permissionBroker.requestPermission({
+      input: executionInput, mode, reason: permissionDecision.reason ?? `Tool ${toolCall.name} requires approval`,
+      requestId, requestedAt: new Date(), riskLevel: permissionDecision.riskLevel, ruleId: permissionDecision.ruleId,
+      sessionId: deps.sessionId, sideEffectScope: permissionDecision.sideEffectScope, suggestedPermissionUpdates,
+      ...(approval?.optionsPolicy ? { optionsPolicy: approval.optionsPolicy } : {}),
+      ...(once ? { optionsPolicy: "no-always-allow" as const } : {}),
+      ...(failure ? { reviewFailure: failure } : {}),
+      toolCallId: toolCall.id as PermissionBrokerRequest["toolCallId"], toolName: toolCall.name,
+      traceId: traceContext.traceId, turnId: traceContext.turnId ?? deps.turnId,
+    }, { signal: brokerSignal, claimResponse, timeoutMs: deps.permissionTimeoutMs,
+      ...(automatic ? { onRegistered: () => publish(failure, once) } : {}) });
+  const reviewEvent = (completed: boolean, outcome?: "allow" | "deny" | "failed" | "cancelled", failure?: ApprovalReviewFailure,
+    actualReviewModel?: import("@zcode/contracts").ModelSelection) =>
+    deps.emitEvent({ id: crypto.randomUUID() as any, sessionId: deps.sessionId,
+      turnId: traceContext.turnId ?? deps.turnId, traceId: traceContext.traceId,
+      timestamp: new Date(), sequenceNumber: 0,
+      type: completed ? SessionEventType.PermissionReviewCompleted : SessionEventType.PermissionReviewStarted,
+      payload: { requestId, toolCallId: toolCall.id, toolName: toolCall.name, outcome, reviewFailure: failure,
+        actualReviewModel: actualReviewModel ?? deps.hookRunner?.automaticReviewModel?.({ matchValue: toolCall.name,
+          ...(completed ? { reviewRequestId: requestId } : {}),
+          matchValues: hookMatcherToolNamesForTool(toolCall.name) }) } });
+  if (automatic) {
+    await reviewEvent(false);
+    let failure: ApprovalReviewFailure | undefined;
+    let result: PermissionBrokerResult | undefined;
+    try {
+      result = await runPermissionRequestHooks(deps, toolCall, executionInput, requestId,
+        permissionDecision, mode, traceContext, signal, value => { failure = approvalReviewFailure(value); });
+      signal?.throwIfAborted();
+    } catch (error) {
+      if (signal?.aborted) { await reviewEvent(true, "cancelled"); throw error; }
+      failure = approvalReviewFailure(error);
+    }
+    if (result && !failure) {
+      await reviewEvent(true, result.decision === "deny" ? "deny" : "allow", undefined, result.actualReviewModel);
+      const fallback = async (resolveNow = false) => {
+        const stale = { code: "stale_context", message: "Automatic review context changed before execution" };
+        await reviewEvent(true, "failed", stale, result!.actualReviewModel);
+        let claimed = false;
+        const manual = await broker(signal, () => { if (claimed) return false; claimed = true; return true; }, stale, true);
+        if (resolveNow) await emitPermissionResolved(deps, toolCall, requestId, manual, traceContext);
+        return manual;
+      };
+      if (result.isStillCurrent?.() === false) return { source: "broker", result: await fallback() };
+      return { source: "hook", result: { ...result, requestManualFallback: () => fallback(true) } };
+    }
+    failure ??= { code: "missing_decision", message: "Automatic review returned no usable decision" };
+    await reviewEvent(true, "failed", failure);
+    // 只在审查失败后启动人工审批；原生 broker 登记应答后才发布弹窗，首次点击不会丢失。
+    let claimed = false;
+    return { source: "broker", result: await broker(signal, () => { if (claimed) return false; claimed = true; return true; }, failure) };
+  }
+  await publish();
+  return racePermissionResponders({
+    requestBroker: (brokerSignal, claim) => broker(brokerSignal, claim),
+    runHooks: hookSignal => runPermissionRequestHooks(deps, toolCall, executionInput, requestId,
+      permissionDecision, mode, traceContext, hookSignal),
+    signal,
+    onHookFailure: error => deps.logger?.warn("PermissionRequest hook failed; waiting for client", {
+      requestId, toolCallId: toolCall.id, errorMessage: approvalReviewFailure(error).message,
+      event: "tool.permission.hook_race_forfeited", module: "core.tool.executor", status: "waiting",
+    }),
+  });
+}
