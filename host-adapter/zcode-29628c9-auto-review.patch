index 0000000..f5d4424
--- /dev/null
+++ b/apps/zcode-cli/packages/adapters/src/exec/approval-bridge.ts
@@ -0,0 +1,163 @@
+import { createHash, randomBytes, randomUUID, timingSafeEqual } from "node:crypto";
+import { chmod, mkdtemp, rm } from "node:fs/promises";
+import { createServer, type Socket } from "node:net";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import type { ApprovalBridgeFactory, ApprovalBridgeOwner, ApprovalBridgePort, HookPluginContext, HookJSONOutput } from "@zcode/contracts";
+
+const MAX_FRAME = 2 * 1024 * 1024;
+const signature = (value: unknown) => createHash("sha256").update(JSON.stringify(value)).digest("hex");
+const ask = (message: string): HookJSONOutput => ({
+  hookSpecificOutput: { hookEventName: "PermissionRequest", decision: { behavior: "ask", message } },
+});
+const fault = (code: string, message: string) => Object.assign(new Error(message), { code });
+
+/** One private endpoint per foreground hook; no ambient environment credentials. */
+export function createNodeApprovalBridgeWithActivity(active: (plugin?: HookPluginContext) => boolean): ApprovalBridgeFactory {
+  return owner => createBridge(owner, active);
+}
+export const createNodeApprovalBridge: ApprovalBridgeFactory = owner => createBridge(owner, () => true);
+
+function createBridge(owner: ApprovalBridgeOwner, isActive: (plugin?: HookPluginContext) => boolean): ApprovalBridgePort {
+  const attempts = new Map<string, number>();
+  return {
+  async open(input, signal, plugin) {
+    input = structuredClone(input);
+    signal?.throwIfAborted();
+    const active = () => isActive(plugin);
+    if (!active()) throw fault("plugin_disabled", "Approval plugin is disabled or uninstalled");
+    let snapshot = structuredClone(owner.snapshot());
+    const directory = process.platform === "win32" ? undefined : await mkdtemp(join(tmpdir(), "zcode-review-"));
+    const address = directory ? join(directory, "bridge.sock") : `\\\\.\\pipe\\zcode-review-${randomUUID()}`;
+    const token = randomBytes(32).toString("hex");
+    const controller = new AbortController();
+    const liveSignal = signal ? AbortSignal.any([signal, controller.signal]) : controller.signal;
+    const deadline = Date.now() + 90000;
+    const timeout = setTimeout(() => controller.abort(fault("timeout", "Automatic review exceeded 90 seconds")), 90000);
+    const connections = new Set<Socket>();
+    let bindingId = signature({ input, snapshot, nonce: randomUUID() });
+    let finished = false, closed = false, busy = false;
+    const current = () => !liveSignal.aborted && active() && signature(snapshot) === signature(owner.snapshot());
+    const server = createServer(socket => {
+      connections.add(socket);
+      socket.once("close", () => connections.delete(socket));
+      socket.on("error", () => {});
+      socket.setEncoding("utf8");
+      let buffer = "", dispatched = false;
+      socket.on("data", chunk => {
+        buffer += chunk;
+        if (Buffer.byteLength(buffer) > MAX_FRAME) { socket.destroy(); return; }
+        if (dispatched || !buffer.includes("\n")) return;
+        dispatched = true;
+        void dispatch(buffer.slice(0, buffer.indexOf("\n"))).then(reply => {
+          if (!socket.destroyed) socket.end(JSON.stringify(reply) + "\n");
+        });
+      });
+    });
+    const close = async () => {
+      if (closed) return;
+      closed = true;
+      clearTimeout(timeout);
+      controller.abort(fault("cancelled", "Approval lease closed"));
+      liveSignal.removeEventListener("abort", onAbort);
+      for (const socket of connections) socket.destroy();
+      if (server.listening) await new Promise<void>(resolve => server.close(() => resolve()));
+      if (directory) await rm(directory, { recursive: true, force: true });
+    };
+    const onAbort = () => { void close(); };
+    async function dispatch(text: string) {
+      let id: unknown;
+      try {
+        liveSignal.throwIfAborted();
+        if (!active()) throw fault("plugin_disabled", "Approval plugin is disabled or uninstalled");
+        if (finished) throw fault("closed", "Approval decision already consumed");
+        const request = JSON.parse(text) as { id?: unknown; token?: unknown; method?: string; params?: Record<string, unknown> };
+        id = request.id;
+        if (typeof request.token !== "string" || request.token.length !== token.length || !timingSafeEqual(Buffer.from(request.token), Buffer.from(token))) {
+          throw fault("authentication", "Invalid approval lease");
+        }
+        let result: unknown;
+        if (request.method === "context/read") {
+          if (busy) throw fault("busy", "A completion is already in progress");
+          snapshot = structuredClone(owner.snapshot());
+          bindingId = signature({ input, snapshot, nonce: randomUUID() });
+          const context = snapshot as Record<string, unknown>;
+          result = { ...context, sessionId: input.sessionId, turnId: input.turnId, requestId: input.requestId,
+            bindingId, deadline, action: { tool: input.toolName, arguments: input.toolInput,
+              fingerprint: signature(input.toolInput), permissionReason: input.reason, riskLevel: input.riskLevel,
+              mode: input.mode, toolCallId: input.toolCallId, sideEffectScope: input.sideEffectScope } };
+        } else if (request.method === "model/complete") {
+          if (!current() || request.params?.bindingId !== bindingId) throw fault("stale_context", "Approval model or authorization context changed");
+          if (busy) throw fault("busy", "Only one completion may run per approval");
+          const messages = request.params?.messages;
+          if (Array.isArray(messages) && messages.length === 2) {
+            const count = (attempts.get(input.requestId) ?? 0) + 1;
+            attempts.set(input.requestId, count);
+            if (attempts.size > 50) attempts.delete(attempts.keys().next().value!);
+            if (count > 3) throw fault("attempt_budget", "Automatic review exhausted its three attempts");
+          }
+          busy = true;
+          const completionController = new AbortController();
+          const completionSignal = AbortSignal.any([liveSignal, completionController.signal]);
+          const watch = setInterval(() => {
+            if (!active()) completionController.abort(fault("plugin_disabled", "Approval plugin is disabled or uninstalled"));
+            else if (!current()) completionController.abort(fault("stale_context", "Approval context changed during completion"));
+          }, 100);
+          try {
+            result = await completeWithCancellation(() => owner.complete(request.params, completionSignal), completionSignal);
+            completionSignal.throwIfAborted();
+            liveSignal.throwIfAborted();
+            if (!current()) throw fault("stale_context", "Approval context changed during completion");
+          } finally { clearInterval(watch); busy = false; }
+        } else throw fault("method", "Unknown approval bridge method");
+        if (Buffer.byteLength(JSON.stringify(result)) > MAX_FRAME) throw fault("input_budget", "Approval reply exceeds budget");
+        return { id, result };
+      } catch (error) {
+        const e = error as Error & { code?: string; retryable?: boolean };
+        return { id, error: { code: e.code ?? "model_error", message: e.message, retryable: e.retryable === true } };
+      }
+    }
+    try {
+      await new Promise<void>((resolve, reject) => {
+        server.once("error", reject);
+        server.listen(address, () => { server.removeListener("error", reject); resolve(); });
+      });
+      if (directory) await chmod(address, 0o600);
+      liveSignal.addEventListener("abort", onAbort, { once: true });
+      liveSignal.throwIfAborted();
+    } catch (error) { await close(); throw error; }
+    return {
+      env: { ZCODE_APPROVAL_BRIDGE_SOCKET: address, ZCODE_APPROVAL_BRIDGE_TOKEN: token, ZCODE_APPROVAL_BRIDGE_VERSION: "1" },
+      finish(output) {
+        if (finished || closed || liveSignal.aborted) return ask("Approval cancelled or expired");
+        const specific = output?.hookSpecificOutput;
+        if (specific?.hookEventName !== "PermissionRequest" || !specific.decision) return ask("Automatic review returned no decision");
+        const decision = specific.decision;
+        if (decision.behavior === "ask") return ask(decision.message ?? "Automatic review needs manual approval");
+        if (!current() || decision.bindingId !== bindingId) return ask("STALE_CONTEXT: approval snapshot expired");
+        const assessment = decision.assessment;
+        if (!assessment || assessment.outcome !== decision.behavior) return ask("Automatic review assessment is invalid");
+        finished = true;
+        const interrupt = owner.record(decision.behavior, assessment, input);
+        // Ignore plugin permission updates, modified arguments and interrupt flags.
+        return { hookSpecificOutput: { hookEventName: "PermissionRequest", decision: decision.behavior === "allow"
+          ? { behavior: "allow" }
+          : { behavior: "deny", interrupt, message: decision.message ?? assessment.rationale } } };
+      },
+      close,
+    };
+  },
+  };
+};
+
+async function completeWithCancellation(operation: () => Promise<unknown>, signal: AbortSignal): Promise<unknown> {
+  signal.throwIfAborted();
+  let rejectAbort: (reason?: unknown) => void = () => {};
+  const aborted = new Promise<never>((_resolve, reject) => { rejectAbort = reject; });
+  const abort = () => rejectAbort(signal.reason);
+  signal.addEventListener("abort", abort, { once: true });
+  try {
+    if (signal.aborted) abort();
+    return await Promise.race([operation(), aborted]);
+  } finally { signal.removeEventListener("abort", abort); }
+}
