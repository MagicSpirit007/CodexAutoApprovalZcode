@@ -0,0 +1,15 @@
+import { reviewModelSelectionSchema, type PluginOptionValues } from "@zcode/contracts/plugins";
+
+/** Native configure admission owns validation; references never carry credentials. */
+export function normalizePluginOptions(options: Record<string, unknown>, pluginId: string): PluginOptionValues {
+  const result: PluginOptionValues = {};
+  for (const [key, value] of Object.entries(options)) {
+    // 审查模型只接受引用，不允许对象配置偷偷复制 URL、协议或凭据。
+    if (key === "reviewModel" && pluginId === "codex-auto-approval@codex-auto-review-local") {
+      result[key] = reviewModelSelectionSchema.parse(value);
+      continue;
+    }
+    if (typeof value === "string" || typeof value === "number" || typeof value === "boolean") result[key] = value;
+  }
+  return result;
+}
