+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { normalizePluginOptions } from "../src/plugins/review-model-options.js";
+const pluginId = "codex-auto-approval@codex-auto-review-local";
+test("configure preserves references and reasoning while retaining ordinary options", () => {
+  const reviewModel = { mode: "specified", providerId: "custom-provider", modelId: "deepseek-flash", options: { reasoningLevel: "high" } };
+  assert.deepEqual(normalizePluginOptions({ reviewModel, enabled: true }, pluginId), { reviewModel, enabled: true });
