+++ b/packages/ui/src/v4/PermissionReviewStatus.tsx
@@ -0,0 +1,62 @@
+import type { ToolCallRow } from "@zcode/shared/zcode-protocol-v4";
+import {
+  Tooltip,
+  TooltipContent,
+  TooltipProvider,
+  TooltipTrigger,
+} from "@/components/ui/tooltip.js";
+import { useZCodeIntl } from "@/i18n/IntlProvider.js";
+
+export function PermissionReviewStatus({ row }: { row: ToolCallRow }) {
+  const { intl } = useZCodeIntl();
+  const review = row.permissionReview;
+  if (!review) return null;
+  const reviewing = review.status === "reviewing";
+  // 旧进度不能覆盖终态工具；已完成审查是持久化事实，工具完成后仍需显示实际模型。
+  if (reviewing && ["success", "error", "cancelled"].includes(row.status)) return null;
+  const labels = {
+    reviewing: "chat.permission.autoReviewing",
+    allow: "chat.permission.autoReviewAllowed",
+    deny: "chat.permission.autoReviewDenied",
+    failed: "chat.permission.autoReviewFailedShort",
+    cancelled: "chat.permission.autoReviewCancelled",
+  };
+  const model = review.actualReviewModel;
+  const status = (
+    <p
+      role="status"
+      tabIndex={model ? 0 : undefined}
+      data-testid={reviewing ? "auto-review-progress" : "auto-review-result"}
+      data-review-status={review.status}
+      data-review-provider-id={model?.providerId}
+      data-review-model-id={model?.modelId}
+      data-review-reasoning={model?.options?.reasoningLevel}
+      className={`text-ui-caption text-foreground-subtle${reviewing ? " animate-pulse" : ""}`}
+    >
+      {intl.formatMessage({ id: labels[review.status] })}
+      {model ? ` · ${model.modelId}` : ""}
+    </p>
+  );
+  if (!model) return status;
+  return (
+    <TooltipProvider>
+      <Tooltip>
+        <TooltipTrigger asChild>{status}</TooltipTrigger>
+        <TooltipContent data-testid="auto-review-model-details" className="flex-col items-start">
+          <span>
+            {intl.formatMessage({ id: "chat.permission.reviewProvider" })}: {model.providerId}
+          </span>
+          <span>
+            {intl.formatMessage({ id: "chat.permission.reviewModel" })}: {model.modelId}
+          </span>
+          {model.options?.reasoningLevel ? (
+            <span>
+              {intl.formatMessage({ id: "chat.permission.reviewReasoning" })}:{" "}
+              {model.options.reasoningLevel}
+            </span>
+          ) : null}
+        </TooltipContent>
+      </Tooltip>
+    </TooltipProvider>
+  );
+}
