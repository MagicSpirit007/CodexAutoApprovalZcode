+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { ApiKeyAccessConfig, ModelConfig, ModelConfigRules, ProviderApiConfig, ProviderConfig, ProviderConfigMap,
+  ProviderRegistryService, ProviderTemplateMap } from "@zcode/provider";
+import { validateApprovalReviewSelection } from "../src/app/approval-review-selection.js";
+
+test("real native resolver distinguishes missing credentials from deleted provider and model", async () => {
+  const providers = new ProviderConfigMap([
+    ["missing-key", new ProviderConfig({ group: "standard-personal", access: new ApiKeyAccessConfig(),
+      api: new ProviderApiConfig({ type: "openai-chat-completions", baseUrl: "https://private.invalid/v1" }) })],
+    ["valid-provider", new ProviderConfig({ group: "standard-personal", access: new ApiKeyAccessConfig({ apiKey: "test-private-sentinel" }),
+      api: new ProviderApiConfig({ type: "anthropic-messages", baseUrl: "https://private.invalid" }), personalModelIds: ["review"] })],
+  ]);
+  const config = { revision: "test", zcodeBuiltinRevision: "test", personalRevision: "test",
+    zcodeBuiltinProviders: ProviderConfigMap.empty(), zcodeBuiltinProviderTemplates: ProviderTemplateMap.empty(),
+    personalProviders: providers, zcodeBuiltinModelRules: new ModelConfigRules(), personalModels: new ModelConfigRules([
+      { type: "provider-model", providerId: "valid-provider", modelId: "review", config: ModelConfig.fromData({ enabled: true,
+        properties: { contextWindow: 20000, requiresMfjsToolSchema: false, supportsToolCall: true, supportsJsonSchemaOutput: false,
+          supportsNativeWebSearch: false, supportsMidConversationSystem: true,
+          inputFormat: { supportsText: true, supportsImage: false, supportsVideo: false, supportsAudio: false, supportsPdf: false }, outputFormat: { supportsText: true } },
+        optionSpecs: { reasoningLevel: { values: ["high"], map: "{}" }, maxOutputTokens: { max: 4096, map: "{}" } } }) },
+    ]) };
+  const registry = new ProviderRegistryService({
+    configSource: { read: async () => config, onDidChange: () => () => {} },
+    accountSource: { read: async () => ({ revision: "test", basedOnZCodeBuiltinRevision: "test", providers: ProviderConfigMap.empty() }), onDidChange: () => () => {} },
+  });
+  await registry.start();
+  try {
+    assert.equal(registry.getProvider("missing-key"), undefined);
+    assert.ok(registry.getProvider("valid-provider"));
+    for (const [providerId, code] of [["missing-key", "credentials_missing"], ["deleted", "provider_not_found"], ["valid-provider", "model_not_found"]]) {
+      const result = validateApprovalReviewSelection(registry, { providerId, modelId: "deleted-model" });
+      assert.equal(result.ok, false);
+      if (!result.ok) assert.equal(result.code, code);
+      assert.doesNotMatch(JSON.stringify(result), /test-private-sentinel|private\.invalid|apiKey/);
+    }
+    assert.equal(validateApprovalReviewSelection(registry, { providerId: "valid-provider", modelId: "review", options: { reasoningLevel: "high" } }).ok, true);
+    const incompatible = validateApprovalReviewSelection(registry, { providerId: "valid-provider", modelId: "review", options: { reasoningLevel: "unsupported" } });
+    assert.equal(incompatible.ok, false);
+    if (!incompatible.ok) assert.equal(incompatible.code, "reasoning_level_not_supported");
+  } finally { registry.dispose(); }
+});
