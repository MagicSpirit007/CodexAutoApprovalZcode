+import { existsSync } from "node:fs";
+import type { ApprovalBridgeFactory } from "@zcode/contracts";
+import { loadFileConfig } from "../config/index.js";
+import { createNodeApprovalBridgeWithActivity } from "./approval-bridge.js";
+
+/** Read the same native config parser used by plugin enable/disable commands. */
+export function createConfiguredNodeApprovalBridge(configPaths: string[]): ApprovalBridgeFactory {
+  return createNodeApprovalBridgeWithActivity(plugin => {
+    if (!plugin) return true;
+    if (!existsSync(plugin.rootPath)) return false;
+    let enabled = true;
+    let pluginEnabled = true;
+    // 配置按 user → project 顺序合并；任一 false 都否决会错误阻断菜单写入的 workspace true。
+    for (const file of configPaths) {
+      if (!existsSync(file)) continue;
+      const loaded = loadFileConfig(file);
+      if (loaded.diagnostics.some(item => item.severity === "error")) return false;
+      enabled = loaded.config.plugins?.enabled ?? enabled;
+      pluginEnabled = loaded.config.plugins?.enabledPlugins?.[plugin.id] ?? pluginEnabled;
+    }
+    return enabled && pluginEnabled;
+  });
+}
