@@ -0,0 +1,33 @@
+import type { HookJSONOutput, PermissionRequestHookInput, HookPluginContext } from "../hooks/index.js";
+import type { ModelSelection } from "../model/index.js";
+
+export interface ApprovalReviewBindingContext {
+  bindingId: string;
+  attempt: number;
+  reviewSelection?: ModelSelection;
+}
+
+/** Native credentials and model handles never cross this boundary. */
+export interface ApprovalBridgeOwner {
+  snapshot(plugin?: HookPluginContext): unknown;
+  complete(params: unknown, signal: AbortSignal, input: PermissionRequestHookInput, context?: ApprovalReviewBindingContext): Promise<unknown>;
+  /** Lease lifecycle owns cleanup even when no successful completion/decision occurs. */
+  clearContinuation?(bindingId: string): void;
+  record(outcome: "allow" | "deny", assessment: unknown, input: PermissionRequestHookInput): boolean;
+}
+
+export interface ApprovalBridgeLease {
+  env: Record<string, string>;
+  finish(output: HookJSONOutput | undefined): HookJSONOutput;
+  close(): Promise<void>;
+}
+
+export interface ApprovalBridgePort {
+  reviewModel?: (plugin?: HookPluginContext, requestId?: string) => ModelSelection | undefined;
+  /** The loaded catalog may survive a disable; read current native activity before review admission. */
+  isActive?: (plugin?: HookPluginContext) => boolean;
+  open(input: PermissionRequestHookInput, signal?: AbortSignal, plugin?: HookPluginContext,
+    onReviewModel?: (selection: ModelSelection) => Promise<void>): Promise<ApprovalBridgeLease>;
+}
+
+export type ApprovalBridgeFactory = (owner: ApprovalBridgeOwner) => ApprovalBridgePort;
