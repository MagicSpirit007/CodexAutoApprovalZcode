diff --git a/packages/desktop/src/main/autoReviewUpdateProvider.ts b/packages/desktop/src/main/autoReviewUpdateProvider.ts
new file mode 100755
index 0000000..5eb6e84
--- /dev/null
+++ b/packages/desktop/src/main/autoReviewUpdateProvider.ts
@@ -0,0 +1,120 @@
+import { readFile } from "node:fs/promises";
+import { join } from "node:path";
+import { getDataBaseDir } from "@zcode/services/node";
+import { validateAutoReviewUpdate, type AutoReviewUpdateManifest } from "@zcode/shared";
+import { type AppUpdater, type UpdateInfo, type ResolvedUpdateFileInfo } from "electron-updater";
+import { Provider } from "electron-updater/out/providers/Provider.js";
+import type { CustomPublishOptions } from "builder-util-runtime";
+import type { ProviderRuntimeOptions } from "electron-updater/out/providers/Provider.js";
+import { parse } from "yaml";
+import { autoReviewRelease, autoReviewTestBuild } from "./autoReviewRelease.js";
+import { verifyAutoReviewInstallerIntegrity } from "./autoReviewInstallerIntegrity.js";
+
+interface Options extends CustomPublishOptions {
+  url: string;
+}
+
+async function installedCodexVersions(): Promise<string[]> {
+  const file = join(getDataBaseDir(), ".zcode", "cli", "plugins", "installed_plugins.json");
+  let raw: string;
+  try {
+    raw = await readFile(file, "utf8");
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT") return [];
+    throw error;
+  }
+  const state = JSON.parse(raw) as { plugins?: Array<{ name: string; version: string }> };
+  if (!Array.isArray(state.plugins)) throw new Error("Cannot verify installed plugin versions");
+  return state.plugins
+    .filter((plugin) => plugin.name === "codex-auto-approval")
+    .map((plugin) => plugin.version);
+}
+
+/** 只接独立稳定清单；metadata 校验先于 electron-updater 的版本与下载事件。 */
+export class AutoReviewUpdateProvider extends Provider<UpdateInfo> {
+  private readonly baseUrl: URL;
+  private readonly validated = new Map<string, AutoReviewUpdateManifest>();
+  constructor(options: Options, _updater: AppUpdater, runtime: ProviderRuntimeOptions) {
+    super(runtime);
+    if (!autoReviewRelease) throw new Error("AutoReview release identity missing");
+    const productionUrl = autoReviewRelease.updateFeedUrl;
+    if (options.url !== productionUrl && !autoReviewTestBuild)
+      throw new Error("AutoReview feed override rejected");
+    this.baseUrl = new URL(options.url);
+    if (
+      autoReviewTestBuild &&
+      options.url !== productionUrl &&
+      !["127.0.0.1", "localhost"].includes(this.baseUrl.hostname)
+    ) {
+      throw new Error("Acceptance feed must be loopback");
+    }
+  }
+  async getLatestVersion(): Promise<UpdateInfo> {
+    const info: unknown = parse(
+      (await this.httpRequest(new URL("latest.yml", this.baseUrl))) ?? "",
+    );
+    validateAutoReviewUpdate(
+      info,
+      autoReviewRelease!,
+      await installedCodexVersions(),
+      autoReviewTestBuild ? this.baseUrl.origin : undefined,
+    );
+    const previous = this.validated.get(info.version);
+    if (previous && JSON.stringify(previous) !== JSON.stringify(info)) {
+      throw new Error("Published AutoReview release metadata changed for the same version");
+    }
+    this.validated.set(info.version, info);
+    return {
+      ...info,
+      path: info.files[0]!.url,
+      sha512: info.files[0]!.sha512,
+      releaseDate: (info as unknown as { releaseDate?: string }).releaseDate ?? "",
+      releaseName: `ZCode AutoReview ${info.version} (ZCode ${info.autoReview.upstreamVersion})`,
+      zcodeReleaseChannel: "stable",
+    } as UpdateInfo;
+  }
+  async revalidate(version: string, installerFile?: string): Promise<void> {
+    const info = this.validated.get(version);
+    if (!info) throw new Error("Selected update has no validated release metadata");
+    validateAutoReviewUpdate(
+      info,
+      autoReviewRelease!,
+      await installedCodexVersions(),
+      autoReviewTestBuild ? this.baseUrl.origin : undefined,
+    );
+    if (installerFile) await verifyAutoReviewInstallerIntegrity(installerFile, info.files[0]!);
+  }
+  compatiblePluginVersions(version: string): string[] {
+    const info = this.validated.get(version);
+    if (!info) throw new Error("Selected update compatibility is unavailable");
+    return [...info.autoReview.supportedPluginVersions];
+  }
+  resolveFiles(info: UpdateInfo): ResolvedUpdateFileInfo[] {
+    validateAutoReviewUpdate(
+      info,
+      autoReviewRelease!,
+      [],
+      autoReviewTestBuild ? this.baseUrl.origin : undefined,
+    );
+    return info.files.map((file) => ({
+      url: new URL(file.url),
+      info: { ...file, url: new URL(file.url).pathname.split("/").pop()! },
+    }));
+  }
+}
+
+let activeProvider: AutoReviewUpdateProvider | null = null;
+export class ActiveAutoReviewUpdateProvider extends AutoReviewUpdateProvider {
+  constructor(options: Options, updater: AppUpdater, runtime: ProviderRuntimeOptions) {
+    super(options, updater, runtime);
+    activeProvider = this;
+  }
+}
+export async function revalidateAutoReviewUpdate(version: string, installerFile?: string): Promise<void> {
+  if (!activeProvider) throw new Error("AutoReview update provider unavailable");
+  await activeProvider.revalidate(version, installerFile);
+}
+export function autoReviewUpdateCompatiblePluginVersions(version: string): string[] {
+  if (!activeProvider) throw new Error("AutoReview update provider unavailable");
+  return activeProvider.compatiblePluginVersions(version);
+}
diff --git a/packages/shared/src/auto-review-distribution.ts b/packages/shared/src/auto-review-distribution.ts
new file mode 100755
index 0000000..f14c2bb
--- /dev/null
+++ b/packages/shared/src/auto-review-distribution.ts
@@ -0,0 +1,126 @@
+/** 独立发行的来源与兼容合同；发行版本不能替代原生协议使用的上游版本。 */
+export interface AutoReviewRelease {
+  schemaVersion: 1;
+  distributionVersion: string;
+  applicationId: string;
+  productName: string;
+  executableName: string;
+  upstreamVersion: string;
+  upstreamCommit: string;
+  codexCommit: string;
+  bridgeProtocol: number;
+  pluginVersion: string;
+  supportedPluginVersions: string[];
+  repository: string;
+  updateFeedUrl: string;
+  defaultInstallDirectory: string;
+  dataSchemaChanged: false;
+}
+
+export interface AutoReviewUpdateMetadata {
+  schemaVersion: 1;
+  applicationId: string;
+  upstreamVersion: string;
+  upstreamCommit: string;
+  patchSha256: string;
+  patchSummary: string[];
+  bridgeProtocol: number;
+  supportedPluginVersions: string[];
+  dataSchemaChanged: false;
+}
+
+export interface AutoReviewUpdateManifest {
+  version: string;
+  files: Array<{ url: string; sha512: string; size: number }>;
+  autoReview: AutoReviewUpdateMetadata;
+}
+
+const stableVersion = /^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)$/;
+const object = (value: unknown): value is Record<string, unknown> =>
+  value !== null && typeof value === "object" && !Array.isArray(value);
+
+/** 此校验发生在更新 provider 返回版本之前，坏清单不会进入可下载状态。 */
+export function validateAutoReviewUpdate(
+  raw: unknown,
+  release: AutoReviewRelease,
+  installedPluginVersions: readonly string[] = [],
+  testAssetOrigin?: string,
+): asserts raw is AutoReviewUpdateManifest {
+  function fail(reason: string): never {
+    throw new Error(`AutoReview update rejected: ${reason}`);
+  }
+  if (!object(raw) || typeof raw.version !== "string" || !stableVersion.test(raw.version)) {
+    fail("stable distribution version required");
+  }
+  const info = raw.autoReview;
+  if (!object(info) || info.schemaVersion !== 1 || info.applicationId !== release.applicationId) {
+    fail("application identity or metadata missing");
+  }
+  if (typeof info.upstreamVersion !== "string" || !stableVersion.test(info.upstreamVersion)) {
+    fail("stable upstream version required");
+  }
+  if (typeof info.upstreamCommit !== "string" || !/^[a-f0-9]{40}$/.test(info.upstreamCommit)) {
+    fail("full upstream commit required");
+  }
+  if (typeof info.patchSha256 !== "string" || !/^[a-f0-9]{64}$/.test(info.patchSha256)) {
+    fail("patch checksum required");
+  }
+  if (
+    !Array.isArray(info.patchSummary) ||
+    info.patchSummary.length === 0 ||
+    !info.patchSummary.every((value) => typeof value === "string" && value.trim().length > 0)
+  ) {
+    fail("patch summary required");
+  }
+  if (info.bridgeProtocol !== release.bridgeProtocol || info.dataSchemaChanged !== false) {
+    fail("bridge or data schema incompatible");
+  }
+  if (
+    !Array.isArray(info.supportedPluginVersions) ||
+    !info.supportedPluginVersions.length ||
+    !info.supportedPluginVersions.every(
+      (value) => typeof value === "string" && stableVersion.test(value),
+    )
+  ) {
+    fail("tested plugin versions required");
+  }
+  const supportedPluginVersions = info.supportedPluginVersions;
+  if (installedPluginVersions.some((version) => !supportedPluginVersions.includes(version))) {
+    fail("installed CodexAutoApproval plugin incompatible");
+  }
+  if (!Array.isArray(raw.files) || raw.files.length !== 1)
+    fail("one full Windows installer required");
+  const file = raw.files[0];
+  if (
+    !object(file) ||
+    typeof file.url !== "string" ||
+    typeof file.sha512 !== "string" ||
+    !/^[A-Za-z0-9+/]{86}==$/.test(file.sha512) ||
+    !Number.isSafeInteger(file.size) ||
+    Number(file.size) <= 0
+  ) {
+    fail("installer URL, SHA512 and size required");
+  }
+  let url: URL;
+  try {
+    url = new URL(file.url);
+  } catch {
+    fail("invalid installer URL");
+  }
+  const expected = `/\u0072eleases/download/autoreview-v${raw.version}/${release.executableName}-${raw.version}-win-x64.exe`;
+  const officialPath = `/${release.repository}${expected}`;
+  if (
+    url.username ||
+    url.password ||
+    url.search ||
+    url.hash ||
+    (!(
+      url.protocol === "https:" &&
+      url.hostname === "github.com" &&
+      url.pathname === officialPath
+    ) &&
+      !(testAssetOrigin && url.origin === testAssetOrigin && url.pathname === expected))
+  ) {
+    fail("installer outside the pinned release repository");
+  }
+}
diff --git a/packages/shared/src/update-install-lease.ts b/packages/shared/src/update-install-lease.ts
new file mode 100755
index 0000000..558c713
--- /dev/null
+++ b/packages/shared/src/update-install-lease.ts
@@ -0,0 +1,38 @@
+/** 安装租约先关闭准入，再读取运行时事实，避免空闲检查与新任务交错。 */
+export class UpdateInstallLease {
+  private owner: string | undefined;
+  private inFlight = 0;
+  enter(): () => void {
+    if (this.owner)
+      throw new Error("Update installation is preparing; retry after preparation finishes");
+    this.inFlight++;
+    let released = false;
+    return () => {
+      if (!released) {
+        released = true;
+        this.inFlight--;
+      }
+    };
+  }
+  acquire(id: string, isBusy: () => boolean): void {
+    if (!id) throw new Error("Update lease id is required");
+    if (this.owner === id) return;
+    if (this.owner) throw new Error("Another update installation is preparing");
+    this.owner = id;
+    try {
+      if (this.inFlight > 0 || isBusy())
+        throw new Error(
+          "Tasks, reviews or workflows are still running; finish them before updating",
+        );
+    } catch (error) {
+      this.owner = undefined;
+      throw error;
+    }
+  }
+  release(id: string): void {
+    if (this.owner === id) this.owner = undefined;
+  }
+  get preparing(): boolean {
+    return this.owner !== undefined;
+  }
+}
