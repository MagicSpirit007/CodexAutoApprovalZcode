@@ -0,0 +1,51 @@
+import { ModelErrorCode } from "@zcode/contracts";
+import { AiSdkModelAdapterError } from "./errors.js";
+
+const RESPONSES_API_FORMAT = "openai-responses";
+const ENCRYPTED_REASONING_INCLUDE = "reasoning.encrypted_content";
+const record = (value: unknown): Record<string, unknown> =>
+  value !== null && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : {};
+
+/** Apply review-only statelessness at the native request-option boundary. */
+export function approvalResponsesOptions(input: {
+  querySource?: string;
+  providerKind?: string;
+  base?: Record<string, unknown>;
+  override?: Record<string, unknown>;
+  merged?: Record<string, unknown>;
+}): Record<string, unknown> | undefined {
+  // 必须依据已解析协议与归因命中；请求选项不能伪造协议而影响主会话或其他接口。
+  if (
+    input.querySource !== "auto_review" ||
+    input.providerKind !== "openai" ||
+    input.base?.apiFormat !== RESPONSES_API_FORMAT
+  )
+    return input.merged;
+  const base = record(input.base?.openai);
+  const override = record(input.override?.openai);
+  const includes = [base.include, override.include].flatMap((value) => {
+    if (value === undefined || value === null) return [];
+    if (!Array.isArray(value) || value.some((item) => typeof item !== "string")) {
+      throw new AiSdkModelAdapterError(
+        ModelErrorCode.InvalidModelRequest,
+        "Review Responses include must be an array of strings",
+      );
+    }
+    return value as string[];
+  });
+  const openai = { ...base, ...override };
+  // 审查历史只由 ApprovalContinuation 持有；服务器选择器会漏掉本地完整工具调用。
+  delete openai.previousResponseId;
+  delete openai.conversation;
+  return {
+    ...input.merged,
+    apiFormat: RESPONSES_API_FORMAT,
+    openai: {
+      ...openai,
+      store: false,
+      include: [...new Set([...includes, ENCRYPTED_REASONING_INCLUDE])],
+    },
+  };
+}
