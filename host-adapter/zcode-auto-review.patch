+++ b/packages/desktop/src/host/updateInstallAdmission.ts
@@ -0,0 +1,36 @@
+import { UpdateInstallLease } from "@zcode/shared";
+import type { IChannelServer } from "@zcode/rpc";
+
+export const hostUpdateInstallLease = new UpdateInstallLease();
+
+export async function runAdmittedHostWork<T>(work: () => Promise<T>): Promise<T> {
+  const release = hostUpdateInstallLease.enter();
+  try {
+    return await work();
+  } finally {
+    release();
+  }
+}
+
+export function guardUpdateInstallAdmission(
+  server: IChannelServer,
+): IChannelServer & { ready(): void } {
+  return {
+    registerChannel(name, channel) {
+      server.registerChannel(name, {
+        async call(context, command, arg, cancellationToken) {
+          if (command === "prepareUpdateInstallation" || command === "releaseUpdateInstallation")
+            throw new Error("Update lifecycle is owned by Desktop Main");
+          const release = hostUpdateInstallLease.enter();
+          try {
+            return await channel.call(context, command, arg, cancellationToken);
+          } finally {
+            release();
+          }
+        },
+        listen: (context, event, arg) => channel.listen(context, event, arg),
+      });
+    },
+    ready: () => server.ready?.(),
+  };
+}
diff --git a/packages/desktop/src/main/autoReviewInstallPreparation.ts b/packages/desktop/src/main/autoReviewInstallPreparation.ts
new file mode 100755
index 0000000..31cc984
--- /dev/null
+++ b/packages/desktop/src/main/autoReviewInstallPreparation.ts
@@ -0,0 +1,63 @@
+import { randomUUID } from "node:crypto";
+import { HostMessageTypes, hostResponseMessageSchema } from "@zcode/shared";
+import type { UtilityProcess } from "electron";
+
+/** Main 只协调生命周期；Host/CLI 对实际任务空闲负责。超时仅表示拒绝安装。 */
+export async function prepareAutoReviewHosts(hosts: UtilityProcess[], compatiblePluginVersions: string[]): Promise<() => void> {
+  if (!compatiblePluginVersions.length) throw new Error("Selected update plugin compatibility is missing");
+  const requestId = randomUUID();
+  const release = () => {
+    for (const host of hosts) {
+      try {
+        host.postMessage({ type: HostMessageTypes.UpdateInstallRelease, requestId });
+      } catch {
+        /* 已退出的 Host 无资源可恢复。 */
+      }
+    }
+  };
+  const results = await Promise.allSettled(
+    hosts.map(
+      (host) =>
+        new Promise<void>((resolve, reject) => {
+          const finish = (error?: Error) => {
+            clearTimeout(timer);
+            host.removeListener("message", onMessage);
+            host.removeListener("exit", onExit);
+            if (error) reject(error);
+            else resolve();
+          };
+          const onExit = () =>
+            finish(new Error("A workspace Host exited during update preparation"));
+          const onMessage = (raw: unknown) => {
+            const result = hostResponseMessageSchema.safeParse(raw);
+            if (
+              !result.success ||
+              result.data.type !== "update-install-prepared" ||
+              result.data.requestId !== requestId
+            )
+              return;
+            finish(
+              result.data.idle ? undefined : new Error(result.data.error ?? "Workspace is busy"),
+            );
+          };
+          const timer = setTimeout(
+            () => finish(new Error("Workspace did not confirm update readiness; retry")),
+            12_000,
+          );
+          host.on("message", onMessage);
+          host.once("exit", onExit);
+          try {
+            host.postMessage({ type: HostMessageTypes.UpdateInstallPrepare, requestId, compatiblePluginVersions });
+          } catch (error) {
+            finish(error instanceof Error ? error : new Error(String(error)));
+          }
+        }),
+    ),
+  );
+  const failure = results.find((result) => result.status === "rejected");
+  if (failure?.status === "rejected") {
+    release();
+    throw failure.reason;
+  }
+  return release;
+}
diff --git a/packages/desktop/src/main/autoReviewInstallerIntegrity.ts b/packages/desktop/src/main/autoReviewInstallerIntegrity.ts
new file mode 100755
index 0000000..bb3840a
--- /dev/null
+++ b/packages/desktop/src/main/autoReviewInstallerIntegrity.ts
@@ -0,0 +1,17 @@
+import { createHash } from "node:crypto";
+import { createReadStream } from "node:fs";
+import { stat } from "node:fs/promises";
+
+/** 下载后缓存仍可能被改写；进入退出准备前重新核验，坏包不能关闭当前应用。 */
+export async function verifyAutoReviewInstallerIntegrity(
+  file: string,
+  expected: { size: number; sha512: string },
+): Promise<void> {
+  const info = await stat(file);
+  if (!info.isFile() || info.size !== expected.size)
+    throw new Error("Update installer size changed; download it again");
+  const hash = createHash("sha512");
+  for await (const chunk of createReadStream(file)) hash.update(chunk);
+  if (hash.digest("base64") !== expected.sha512)
+    throw new Error("Update installer checksum changed; download it again");
+}
