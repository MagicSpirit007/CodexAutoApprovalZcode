@@ -0,0 +1,32 @@
+import { UpdateInstallLease, zcodeProtocolMethods, zcodeUpdateInstallParamsSchema } from "@zcode/shared";
+import type { ZCodeProtocolAgentServerContext } from "./server-types.js";
+
+/** 协议请求与真正的 Core 工作事实共同保护安装，不能以 UI 投影代替。 */
+export class ProtocolUpdateInstallAdmission {
+  private readonly lease = new UpdateInstallLease();
+  constructor(
+    private readonly context: () => ZCodeProtocolAgentServerContext,
+    private readonly hasControlOperations: () => boolean,
+    private readonly verifyCompatibility: (context: ZCodeProtocolAgentServerContext, supported: readonly string[]) => void,
+  ) {}
+  enter(): () => void { return this.lease.enter(); }
+  handle(method: string, params: unknown): { idle: true } | undefined {
+    if (method !== zcodeProtocolMethods.updateInstallPrepare && method !== zcodeProtocolMethods.updateInstallRelease) return;
+    const { requestId, compatiblePluginVersions } = zcodeUpdateInstallParamsSchema.parse(params);
+    if (method === zcodeProtocolMethods.updateInstallRelease) {
+      this.lease.release(requestId);
+      return { idle: true };
+    }
+    if (!compatiblePluginVersions) throw new Error("Selected update plugin compatibility is missing");
+    this.lease.acquire(requestId, () => {
+      const context = this.context();
+      const busy = this.hasControlOperations() || [...context.sessions.entries()].some(([id, record]) =>
+        Boolean(record.activeAbortController) || (record.residencyFinalizationCount ?? 0) > 0 ||
+        record.app.runtime.hasResidencyBlockingWork() || context.v4Interactions.hasPendingForSession(id) ||
+        (context.v4Gateway?.hasResidencyBlockingCommands(id) ?? false));
+      if (!busy) this.verifyCompatibility(context, compatiblePluginVersions);
+      return busy;
+    });
+    return { idle: true };
+  }
+}
diff --git a/apps/zcode-cli/packages/bootstrap/src/zcode-protocol/update-install-compatibility.ts b/apps/zcode-cli/packages/bootstrap/src/zcode-protocol/update-install-compatibility.ts
new file mode 100755
