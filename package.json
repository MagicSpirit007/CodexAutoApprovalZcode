{
  "name": "zcode",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Standalone coding agent with Codex-derived automatic approval review",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "zcode": "bin/zcode.js"
  },
  "scripts": {
    "test:updates": "node --import ./host-adapter/upstream/node_modules/tsx/dist/loader.mjs --test test/update-distribution.test.js test/stable-publisher.test.js",
    "release:adapt": "node scripts/distribution-release.mjs",
    "start": "node bin/zcode.js",
    "test": "node --test test/approval.test.js test/cli.test.js test/model.test.js test/runtime.test.js test/clone-chat-review-config.test.js test/responses-acceptance-protocol.test.js",
    "test:desktop": "node --import ./host-adapter/upstream/node_modules/tsx/dist/loader.mjs --test test/desktop.test.js test/host-chain.test.js",
    "package:desktop": "node scripts/package-desktop.mjs",
    "check": "node scripts/check.js",
    "test:approval-ui": "node ./host-adapter/upstream/node_modules/tsx/dist/cli.mjs --tsconfig ./host-adapter/upstream/packages/ui/tsconfig.json --test test/approval-failure-ui.test.js",
    "test:responses": "node --import ./host-adapter/upstream/node_modules/tsx/dist/loader.mjs --test test/responses-options.test.js test/responses-continuation.test.js",
    "test:responses-live": "node --import ./host-adapter/upstream/node_modules/tsx/dist/loader.mjs scripts/responses-live-review.mjs"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MagicSpirit007/CodexAutoApprovalZcode.git"
  },
  "homepage": "https://github.com/MagicSpirit007/CodexAutoApprovalZcode#readme",
  "bugs": {
    "url": "https://github.com/MagicSpirit007/CodexAutoApprovalZcode/issues"
  }
}
